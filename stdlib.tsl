// Generated by tools/make-stdlib.sh from lib/*.py: don't change it by hand.
//
// The modules of the standard library that are written in Python, as text:
// `import` runs them like a file's (see importModule in modules.tsl).

fn bundledModules() -> [String] {
    ["abc", "bisect", "collections", "copy", "datetime", "functools", "heapq", "itertools", "operator", "re", "statistics", "textwrap"]
}

// A bundled module's Python text, or nil if there's none of that name.
fn bundledModule(_ name: String) -> String? {
    if name == "abc" {
        return bundled_abc()
    }
    if name == "bisect" {
        return bundled_bisect()
    }
    if name == "collections" {
        return bundled_collections()
    }
    if name == "copy" {
        return bundled_copy()
    }
    if name == "datetime" {
        return bundled_datetime()
    }
    if name == "functools" {
        return bundled_functools()
    }
    if name == "heapq" {
        return bundled_heapq()
    }
    if name == "itertools" {
        return bundled_itertools()
    }
    if name == "operator" {
        return bundled_operator()
    }
    if name == "re" {
        return bundled_re()
    }
    if name == "statistics" {
        return bundled_statistics()
    }
    if name == "textwrap" {
        return bundled_textwrap()
    }
    nil
}

fn bundled_abc() -> String {
    [
        "\"\"\"abc: abstract base classes.\n\nA class whose metaclass is ABCMeta (or that inherits from ABC) can't be\ninstantiated while a method marked @abstractmethod is not filled in. The\ninterpreter itself keeps track of which are (objects.tsl); this module\nonly gives the names.\n\"\"\"\n\nabstractmethod = __abstractmethod__\n\n\nclass ABCMeta(type):\n    __module__ = \"abc\"\n\n\nclass ABC(metaclass=ABCMeta):\n    __module__ = \"abc\"\n",
    ].joined()
}

fn bundled_bisect() -> String {
    [
        "# bisect: keeping a list in order without sorting it again.\n#\n# Author: Alexius Academia\n# Date: 2026-10-08\n\n\ndef bisect_right(a, x, lo=0, hi=None, key=None):\n    \"\"\"The place to put x in the sorted list a, after any items equal to it.\"\"\"\n    if lo < 0:\n        raise ValueError(\"lo must be non-negative\")\n    if hi is None:\n        hi = len(a)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        item = a[mid] if key is None else key(a[mid])\n        if x < item:\n            hi = mid\n        else:\n            lo = mid + 1\n    return lo\n\n\ndef bisect_left(a, x, lo=0, hi=None, key=None):\n    \"\"\"The place to put x in the sorted list a, before any items equal to it.\"\"\"\n    if lo < 0:\n        raise ValueError(\"lo must be non-negative\")\n    if hi is None:\n        hi = len(a)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        item = a[mid] if key is None else key(a[mid])\n        if item < x:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo\n\n\ndef insort_right(a, x, lo=0, hi=None, key=None):\n    \"\"\"Puts x in the sorted list a, after any items equal to it.\"\"\"\n",
        "    if key is None:\n        lo = bisect_right(a, x, lo, hi)\n    else:\n        lo = bisect_right(a, key(x), lo, hi, key=key)\n    a.insert(lo, x)\n\n\ndef insort_left(a, x, lo=0, hi=None, key=None):\n    \"\"\"Puts x in the sorted list a, before any items equal to it.\"\"\"\n    if key is None:\n        lo = bisect_left(a, x, lo, hi)\n    else:\n        lo = bisect_left(a, key(x), lo, hi, key=key)\n    a.insert(lo, x)\n\n\nbisect = bisect_right\ninsort = insort_right\n",
    ].joined()
}

fn bundled_collections() -> String {
    [
        "# collections: Counter, defaultdict, OrderedDict, deque, namedtuple, ChainMap.\n#\n# Author: Alexius Academia\n# Date: 2026-10-08\n#\n# PyTessel's classes can't inherit from dict or tuple, so these are\n# classes of their own that hold a dict (or a list, or a tuple) and do\n# what one does: indexing, len(), `in`, iteration, ==, the methods. What\n# they can't be is a dict or a tuple to isinstance().\n\n\ndef _is_mapping(x):\n    return isinstance(x, (dict, _DictLike, ChainMap))\n\n\ndef _plain(x):\n    # The dict inside one of this module's dictionaries.\n    if isinstance(x, _DictLike):\n        return x._d\n    return x\n\n\nclass _DictLike:\n    \"\"\"What Counter, defaultdict and OrderedDict share: a dict, in `_d`.\"\"\"\n\n    def __len__(self):\n        return len(self._d)\n\n    def __iter__(self):\n        return iter(self._d)\n\n    def __contains__(self, key):\n        return key in self._d\n\n    def __getitem__(self, key):\n        return self._d[key]\n\n    def __setitem__(self, key, value):\n        self._d[key] = value\n\n",
        "    def __delitem__(self, key):\n        del self._d[key]\n\n    def __eq__(self, other):\n        if not _is_mapping(other):\n            return False\n        return self._d == _plain(other)\n\n    def __ne__(self, other):\n        return not self == other\n\n    def __or__(self, other):\n        if not _is_mapping(other):\n            raise TypeError(\"unsupported operand type(s) for |: '%s' and '%s'\" % (type(self).__name__, type(other).__name__))\n        result = self.copy()\n        result.update(other)\n        return result\n\n    def __ior__(self, other):\n        self.update(other)\n        return self\n\n    def keys(self):\n        return self._d.keys()\n\n    def values(self):\n        return self._d.values()\n\n    def items(self):\n        return self._d.items()\n\n    def get(self, key, default=None):\n        return self._d.get(key, default)\n\n    def pop(self, key, *default):\n        return self._d.pop(key, *default)\n\n    def popitem(self):\n        return self._d.popitem()\n\n",
        "    def setdefault(self, key, default=None):\n        return self._d.setdefault(key, default)\n\n    def update(self, *args, **kwargs):\n        if len(args) > 1:\n            raise TypeError(\"update expected at most 1 argument, got %d\" % len(args))\n        for other in args:\n            self._d.update(_plain(other))\n        if kwargs:\n            self._d.update(kwargs)\n\n    def clear(self):\n        self._d.clear()\n\n    def __copy__(self):\n        return self.copy()\n\n\n# ---- Counter ----\n\ndef _by_count(item):\n    return item[1]\n\n\nclass Counter(_DictLike):\n    \"\"\"Counts things: Counter(\"hello\")[\"l\"] is 2, and a missing key counts 0.\"\"\"\n\n    __module__ = \"collections\"\n\n    def __init__(self, iterable=None, **kwds):\n        self._d = \{\}\n        self.update(iterable, **kwds)\n\n    def __getitem__(self, key):\n        return self._d.get(key, 0)\n\n    def __delitem__(self, key):\n        # (Unlike a dict's: nothing happens when the key isn't there.)\n        if key in self._d:\n            del self._d[key]\n",
        "\n    def __repr__(self):\n        name = type(self).__name__\n        if not self._d:\n            return name + \"()\"\n        return \"%s(\{%s\})\" % (name, \", \".join([\"%r: %r\" % pair for pair in self.most_common()]))\n\n    def total(self):\n        \"\"\"The sum of the counts.\"\"\"\n        return sum(self._d.values())\n\n    def most_common(self, n=None):\n        \"\"\"The n most common things and their counts, most common first.\"\"\"\n        ordered = sorted(self._d.items(), key=_by_count, reverse=True)\n        if n is None:\n            return ordered\n        return ordered[:n] if n > 0 else []\n\n    def elements(self):\n        \"\"\"Each thing as many times as its count.\"\"\"\n        for element in self._d:\n            for i in range(self._d[element]):\n                yield element\n\n    def update(self, iterable=None, **kwds):\n        \"\"\"Adds counts: of the things of an iterable, or from another mapping.\"\"\"\n        d = self._d\n        if iterable is not None:\n            if _is_mapping(iterable):\n                for element in iterable:\n                    d[element] = d.get(element, 0) + iterable[element]\n            else:\n                for element in iterable:\n                    d[element] = d.get(element, 0) + 1\n        for element in kwds:\n            d[element] = d.get(element, 0) + kwds[element]\n\n    def subtract(self, iterable=None, **kwds):\n        \"\"\"Takes counts away (they can go below zero).\"\"\"\n        d = self._d\n",
        "        if iterable is not None:\n            if _is_mapping(iterable):\n                for element in iterable:\n                    d[element] = d.get(element, 0) - iterable[element]\n            else:\n                for element in iterable:\n                    d[element] = d.get(element, 0) - 1\n        for element in kwds:\n            d[element] = d.get(element, 0) - kwds[element]\n\n    def copy(self):\n        return type(self)(self)\n\n    @classmethod\n    def fromkeys(cls, iterable, v=None):\n        raise NotImplementedError(\"Counter.fromkeys() is undefined.  Use Counter(iterable) instead.\")\n\n    def _other(self, other, symbol):\n        if not isinstance(other, Counter):\n            raise TypeError(\"unsupported operand type(s) for %s: 'Counter' and '%s'\" % (symbol, type(other).__name__))\n\n    def __add__(self, other):\n        self._other(other, \"+\")\n        result = Counter()\n        for element in self._d:\n            count = self._d[element] + other[element]\n            if count > 0:\n                result[element] = count\n        for element in other._d:\n            if element not in self._d and other._d[element] > 0:\n                result[element] = other._d[element]\n        return result\n\n    def __sub__(self, other):\n        self._other(other, \"-\")\n        result = Counter()\n        for element in self._d:\n            count = self._d[element] - other[element]\n            if count > 0:\n                result[element] = count\n",
        "        for element in other._d:\n            if element not in self._d and other._d[element] < 0:\n                result[element] = 0 - other._d[element]\n        return result\n\n    def __or__(self, other):\n        self._other(other, \"|\")\n        result = Counter()\n        for element in self._d:\n            count = self._d[element]\n            theirs = other[element]\n            if theirs > count:\n                count = theirs\n            if count > 0:\n                result[element] = count\n        for element in other._d:\n            if element not in self._d and other._d[element] > 0:\n                result[element] = other._d[element]\n        return result\n\n    def __and__(self, other):\n        self._other(other, \"&\")\n        result = Counter()\n        for element in self._d:\n            count = self._d[element]\n            theirs = other[element]\n            if theirs < count:\n                count = theirs\n            if count > 0:\n                result[element] = count\n        return result\n\n    def __pos__(self):\n        result = Counter()\n        for element in self._d:\n            if self._d[element] > 0:\n                result[element] = self._d[element]\n        return result\n\n    def __neg__(self):\n",
        "        result = Counter()\n        for element in self._d:\n            if self._d[element] < 0:\n                result[element] = 0 - self._d[element]\n        return result\n\n    def _keep_positive(self):\n        for element in list(self._d):\n            if not self._d[element] > 0:\n                del self._d[element]\n        return self\n\n    def __iadd__(self, other):\n        self._other(other, \"+=\")\n        for element in other._d:\n            self._d[element] = self._d.get(element, 0) + other._d[element]\n        return self._keep_positive()\n\n    def __isub__(self, other):\n        self._other(other, \"-=\")\n        for element in other._d:\n            self._d[element] = self._d.get(element, 0) - other._d[element]\n        return self._keep_positive()\n\n    def __ior__(self, other):\n        self._other(other, \"|=\")\n        for element in other._d:\n            if other._d[element] > self._d.get(element, 0):\n                self._d[element] = other._d[element]\n        return self._keep_positive()\n\n    def __iand__(self, other):\n        self._other(other, \"&=\")\n        for element in list(self._d):\n            if other[element] < self._d[element]:\n                self._d[element] = other[element]\n        return self._keep_positive()\n\n\n# ---- defaultdict ----\n",
        "\nclass defaultdict(_DictLike):\n    \"\"\"A dict that makes a value, with default_factory(), for a key it hasn't got.\"\"\"\n\n    __module__ = \"collections\"\n\n    def __init__(self, default_factory=None, *args, **kwargs):\n        if default_factory is not None and not callable(default_factory):\n            raise TypeError(\"first argument must be callable or None\")\n        self.default_factory = default_factory\n        self._d = \{\}\n        self.update(*args, **kwargs)\n\n    def __getitem__(self, key):\n        d = self._d\n        if key in d:\n            return d[key]\n        return self.__missing__(key)\n\n    def __missing__(self, key):\n        if self.default_factory is None:\n            raise KeyError(key)\n        value = self.default_factory()\n        self._d[key] = value\n        return value\n\n    def __repr__(self):\n        return \"%s(%r, %r)\" % (type(self).__name__, self.default_factory, self._d)\n\n    def copy(self):\n        return type(self)(self.default_factory, self._d)\n\n\n# ---- OrderedDict ----\n\nclass OrderedDict(_DictLike):\n    \"\"\"A dict that can move its keys about: move_to_end(), popitem(last=False).\"\"\"\n\n    __module__ = \"collections\"\n\n",
        "    def __init__(self, *args, **kwargs):\n        self._d = \{\}\n        self.update(*args, **kwargs)\n\n    def __repr__(self):\n        name = type(self).__name__\n        if not self._d:\n            return name + \"()\"\n        return \"%s(%r)\" % (name, list(self._d.items()))\n\n    def __eq__(self, other):\n        if isinstance(other, OrderedDict):\n            # (Two of them are equal when their order is the same too.)\n            return list(self._d.items()) == list(other._d.items())\n        if not _is_mapping(other):\n            return False\n        return self._d == _plain(other)\n\n    def __reversed__(self):\n        return reversed(list(self._d))\n\n    def move_to_end(self, key, last=True):\n        \"\"\"Moves a key to the end (or to the start, with last=False).\"\"\"\n        if key not in self._d:\n            raise KeyError(key)\n        value = self._d.pop(key)\n        if last:\n            self._d[key] = value\n        else:\n            old = self._d\n            self._d = \{key: value\}\n            self._d.update(old)\n\n    def popitem(self, last=True):\n        \"\"\"Removes and gives the last (key, value), or the first with last=False.\"\"\"\n        if not self._d:\n            raise KeyError(\"dictionary is empty\")\n        if last:\n            return self._d.popitem()\n        for key in self._d:\n",
        "            break\n        return (key, self._d.pop(key))\n\n    def copy(self):\n        return type(self)(self._d)\n\n    @classmethod\n    def fromkeys(cls, iterable, value=None):\n        result = cls()\n        for key in iterable:\n            result[key] = value\n        return result\n\n\n# ---- deque ----\n\nclass deque:\n    \"\"\"A list that's quick to add to and take from at both ends.\"\"\"\n\n    __module__ = \"collections\"\n\n    def __init__(self, iterable=(), maxlen=None):\n        if maxlen is not None:\n            if not isinstance(maxlen, int):\n                raise TypeError(\"an integer is required\")\n            if maxlen < 0:\n                raise ValueError(\"maxlen must be non-negative\")\n        self.maxlen = maxlen\n        # The items are _items[_head:]: taking one from the left only\n        # moves _head (and the list is cut down now and then).\n        self._items = []\n        self._head = 0\n        self.extend(iterable)\n\n    def _pack(self):\n        if self._head:\n            self._items = self._items[self._head:]\n            self._head = 0\n        return self._items\n\n",
        "    def __len__(self):\n        return len(self._items) - self._head\n\n    def __bool__(self):\n        return len(self._items) > self._head\n\n    def __iter__(self):\n        return iter(self._pack()[:])\n\n    def __reversed__(self):\n        return reversed(self._pack()[:])\n\n    def __contains__(self, value):\n        return value in self._pack()\n\n    def __repr__(self):\n        name = type(self).__name__\n        if self.maxlen is None:\n            return \"%s(%r)\" % (name, self._pack())\n        return \"%s(%r, maxlen=%d)\" % (name, self._pack(), self.maxlen)\n\n    def __eq__(self, other):\n        return isinstance(other, deque) and self._pack() == other._pack()\n\n    def __ne__(self, other):\n        return not self == other\n\n    def _compare(self, other, symbol):\n        if not isinstance(other, deque):\n            raise TypeError(\"'%s' not supported between instances of 'collections.deque' and '%s'\" % (symbol, type(other).__name__))\n        return other._pack()\n\n    def __lt__(self, other):\n        return self._pack() < self._compare(other, \"<\")\n\n    def __le__(self, other):\n        return self._pack() <= self._compare(other, \"<=\")\n\n    def __gt__(self, other):\n        return self._pack() > self._compare(other, \">\")\n",
        "\n    def __ge__(self, other):\n        return self._pack() >= self._compare(other, \">=\")\n\n    def _place(self, index):\n        size = len(self._items) - self._head\n        if not isinstance(index, int):\n            raise TypeError(\"sequence index must be integer, not '%s'\" % type(index).__name__)\n        if index < 0:\n            index += size\n        if index < 0 or index >= size:\n            raise IndexError(\"deque index out of range\")\n        return self._head + index\n\n    def __getitem__(self, index):\n        return self._items[self._place(index)]\n\n    def __setitem__(self, index, value):\n        self._items[self._place(index)] = value\n\n    def __delitem__(self, index):\n        at = self._place(index)\n        del self._items[at]\n\n    def __add__(self, other):\n        if not isinstance(other, deque):\n            raise TypeError(\"can only concatenate deque (not \\\"%s\\\") to deque\" % type(other).__name__)\n        result = deque(self, self.maxlen)\n        result.extend(other)\n        return result\n\n    def __iadd__(self, other):\n        self.extend(other)\n        return self\n\n    def __mul__(self, n):\n        return deque(self._pack() * n, self.maxlen)\n\n    def __rmul__(self, n):\n        return deque(self._pack() * n, self.maxlen)\n",
        "\n    def __copy__(self):\n        return deque(self, self.maxlen)\n\n    def append(self, x):\n        \"\"\"Adds x on the right.\"\"\"\n        if self.maxlen is not None and len(self._items) - self._head >= self.maxlen:\n            if self.maxlen == 0:\n                return\n            self.popleft()\n        self._items.append(x)\n\n    def appendleft(self, x):\n        \"\"\"Adds x on the left.\"\"\"\n        if self.maxlen is not None and len(self._items) - self._head >= self.maxlen:\n            if self.maxlen == 0:\n                return\n            self._items.pop()\n        if self._head > 0:\n            self._head -= 1\n            self._items[self._head] = x\n        else:\n            self._items.insert(0, x)\n\n    def pop(self):\n        \"\"\"Removes and gives the item on the right.\"\"\"\n        if len(self._items) <= self._head:\n            raise IndexError(\"pop from an empty deque\")\n        return self._items.pop()\n\n    def popleft(self):\n        \"\"\"Removes and gives the item on the left.\"\"\"\n        head = self._head\n        items = self._items\n        if len(items) <= head:\n            raise IndexError(\"pop from an empty deque\")\n        x = items[head]\n        items[head] = None\n        head += 1\n        if head > 32 and head * 2 > len(items):\n",
        "            self._items = items[head:]\n            head = 0\n        self._head = head\n        return x\n\n    def extend(self, iterable):\n        \"\"\"Adds each item on the right.\"\"\"\n        if iterable is self:\n            iterable = list(iterable)\n        if self.maxlen is None:\n            self._items.extend(iterable)\n        else:\n            for x in iterable:\n                self.append(x)\n\n    def extendleft(self, iterable):\n        \"\"\"Adds each item on the left (so they end up in the opposite order).\"\"\"\n        if iterable is self:\n            iterable = list(iterable)\n        for x in iterable:\n            self.appendleft(x)\n\n    def clear(self):\n        self._items = []\n        self._head = 0\n\n    def copy(self):\n        return type(self)(self, self.maxlen)\n\n    def count(self, x):\n        return self._pack().count(x)\n\n    def index(self, x, start=0, stop=None):\n        items = self._pack()\n        size = len(items)\n        if start < 0:\n            start = max(start + size, 0)\n        if stop is None or stop > size:\n            stop = size\n        elif stop < 0:\n",
        "            stop = max(stop + size, 0)\n        for i in range(start, stop):\n            if items[i] == x:\n                return i\n        raise ValueError(\"%r is not in deque\" % (x,))\n\n    def insert(self, i, x):\n        if self.maxlen is not None and len(self) >= self.maxlen:\n            raise IndexError(\"deque already at its maximum size\")\n        self._pack().insert(i, x)\n\n    def remove(self, value):\n        items = self._pack()\n        for i in range(len(items)):\n            if items[i] == value:\n                del items[i]\n                return\n        raise ValueError(\"deque.remove(x): x not in deque\")\n\n    def reverse(self):\n        self._pack().reverse()\n\n    def rotate(self, n=1):\n        \"\"\"Moves the items n steps to the right (to the left, for a negative n).\"\"\"\n        items = self._pack()\n        size = len(items)\n        if size == 0:\n            return\n        k = n % size\n        if k:\n            self._items = items[size - k:] + items[:size - k]\n\n\n# ---- namedtuple ----\n\n_KEYWORDS = (\"False\", \"None\", \"True\", \"and\", \"as\", \"assert\", \"async\", \"await\", \"break\", \"class\", \"continue\",\n             \"def\", \"del\", \"elif\", \"else\", \"except\", \"finally\", \"for\", \"from\", \"global\", \"if\", \"import\", \"in\",\n             \"is\", \"lambda\", \"nonlocal\", \"not\", \"or\", \"pass\", \"raise\", \"return\", \"try\", \"while\", \"with\", \"yield\")\n\n\n",
        "def _quoted_names(names):\n    # 'a', 'b' and 'c'\n    quoted = [\"'%s'\" % name for name in names]\n    if len(quoted) == 1:\n        return quoted[0]\n    if len(quoted) == 2:\n        return quoted[0] + \" and \" + quoted[1]\n    return \", \".join(quoted[:len(quoted) - 1]) + \", and \" + quoted[len(quoted) - 1]\n\n\ndef _field_getter(index):\n    def getter(self):\n        return self._values[index]\n    return getter\n\n\nclass _NamedTuple:\n    \"\"\"What every class namedtuple() makes inherits: a tuple, in `_values`.\"\"\"\n\n    def __init__(self, *args, **kwargs):\n        fields = self._fields\n        count = len(fields)\n        if len(args) > count:\n            raise TypeError(\"%s.__new__() takes %d positional argument%s but %d were given\"\n                            % (type(self).__name__, count + 1, \"\" if count == 0 else \"s\", len(args) + 1))\n        values = list(args)\n        missing = []\n        defaults = self._field_defaults\n        for i in range(len(args), count):\n            name = fields[i]\n            if name in kwargs:\n                values.append(kwargs.pop(name))\n            elif name in defaults:\n                values.append(defaults[name])\n            else:\n                missing.append(name)\n        for name in kwargs:\n            if name in fields:\n                raise TypeError(\"%s.__new__() got multiple values for argument '%s'\" % (type(self).__name__, name))\n            raise TypeError(\"%s.__new__() got an unexpected keyword argument '%s'\" % (type(self).__name__, name))\n",
        "        if missing:\n            raise TypeError(\"%s.__new__() missing %d required positional argument%s: %s\"\n                            % (type(self).__name__, len(missing), \"\" if len(missing) == 1 else \"s\",\n                               _quoted_names(missing)))\n        self._values = tuple(values)\n\n    def __repr__(self):\n        parts = []\n        for i in range(len(self._fields)):\n            parts.append(\"%s=%r\" % (self._fields[i], self._values[i]))\n        return \"%s(%s)\" % (type(self).__name__, \", \".join(parts))\n\n    def __len__(self):\n        return len(self._values)\n\n    def __iter__(self):\n        return iter(self._values)\n\n    def __getitem__(self, index):\n        return self._values[index]\n\n    def __contains__(self, value):\n        return value in self._values\n\n    def __hash__(self):\n        return hash(self._values)\n\n    def __eq__(self, other):\n        if isinstance(other, _NamedTuple):\n            return self._values == other._values\n        return isinstance(other, tuple) and self._values == other\n\n    def __ne__(self, other):\n        return not self == other\n\n    def _tuple_of(self, other, symbol):\n        if isinstance(other, _NamedTuple):\n            return other._values\n        if isinstance(other, tuple):\n            return other\n",
        "        raise TypeError(\"'%s' not supported between instances of '%s' and '%s'\"\n                        % (symbol, type(self).__name__, type(other).__name__))\n\n    def __lt__(self, other):\n        return self._values < self._tuple_of(other, \"<\")\n\n    def __le__(self, other):\n        return self._values <= self._tuple_of(other, \"<=\")\n\n    def __gt__(self, other):\n        return self._values > self._tuple_of(other, \">\")\n\n    def __ge__(self, other):\n        return self._values >= self._tuple_of(other, \">=\")\n\n    def __add__(self, other):\n        if isinstance(other, _NamedTuple):\n            return self._values + other._values\n        return self._values + other\n\n    def __radd__(self, other):\n        return other + self._values\n\n    def __mul__(self, n):\n        return self._values * n\n\n    def __rmul__(self, n):\n        return self._values * n\n\n    def count(self, value):\n        return self._values.count(value)\n\n    def index(self, value):\n        return self._values.index(value)\n\n    def _asdict(self):\n        \"\"\"The fields and their values, as a dict.\"\"\"\n        out = \{\}\n        for i in range(len(self._fields)):\n            out[self._fields[i]] = self._values[i]\n",
        "        return out\n\n    def _replace(self, **kwargs):\n        \"\"\"A copy, with some fields given new values.\"\"\"\n        values = []\n        for name in self._fields:\n            if name in kwargs:\n                values.append(kwargs.pop(name))\n            else:\n                values.append(getattr(self, name))\n        if kwargs:\n            raise ValueError(\"Got unexpected field names: %r\" % (list(kwargs),))\n        return type(self)(*values)\n\n    def __copy__(self):\n        return self\n\n    def __deepcopy__(self, memo):\n        import copy\n        return type(self)(*[copy.deepcopy(v, memo) for v in self._values])\n\n\ndef _nt_make(cls, iterable):\n    values = tuple(iterable)\n    if len(values) != len(cls._fields):\n        raise TypeError(\"Expected %d arguments, got %d\" % (len(cls._fields), len(values)))\n    return cls(*values)\n\n\ndef _nt_class(typename):\n    # The class is written out and run, so that it has the name asked\n    # for. (It's the only class among this function's variables.)\n    exec(\"class %s(_NamedTuple):\\n    pass\\n\" % typename)\n    for value in locals().values():\n        if isinstance(value, type):\n            return value\n\n\ndef namedtuple(typename, field_names, rename=False, defaults=None, module=None):\n    \"\"\"A new class like a tuple, whose items also have names: Point = namedtuple(\"Point\", \"x y\").\"\"\"\n",
        "    if isinstance(field_names, str):\n        field_names = field_names.replace(\",\", \" \").split()\n    field_names = [str(name) for name in field_names]\n    typename = str(typename)\n    if rename:\n        seen = set()\n        for index in range(len(field_names)):\n            name = field_names[index]\n            if not name.isidentifier() or name in _KEYWORDS or name.startswith(\"_\") or name in seen:\n                field_names[index] = \"_%d\" % index\n            seen.add(name)\n    for name in [typename] + field_names:\n        if not name.isidentifier():\n            raise ValueError(\"Type names and field names must be valid identifiers: %r\" % name)\n        if name in _KEYWORDS:\n            raise ValueError(\"Type names and field names cannot be a keyword: %r\" % name)\n    seen = set()\n    for name in field_names:\n        if name.startswith(\"_\") and not rename:\n            raise ValueError(\"Field names cannot start with an underscore: %r\" % name)\n        if name in seen:\n            raise ValueError(\"Encountered duplicate field name: %r\" % name)\n        seen.add(name)\n    field_defaults = \{\}\n    if defaults is not None:\n        defaults = tuple(defaults)\n        if len(defaults) > len(field_names):\n            raise TypeError(\"Got more default values than field names\")\n        first = len(field_names) - len(defaults)\n        for i in range(len(defaults)):\n            field_defaults[field_names[first + i]] = defaults[i]\n    cls = _nt_class(typename)\n    cls._fields = tuple(field_names)\n    cls._field_defaults = field_defaults\n    cls._make = classmethod(_nt_make)\n    for index in range(len(field_names)):\n        setattr(cls, field_names[index], property(_field_getter(index)))\n    return cls\n\n\n",
        "# ---- ChainMap ----\n\nclass ChainMap:\n    \"\"\"Several mappings seen as one: a key is looked for in each in turn.\"\"\"\n\n    __module__ = \"collections\"\n\n    def __init__(self, *maps):\n        self.maps = list(maps) or [\{\}]\n\n    def __getitem__(self, key):\n        for mapping in self.maps:\n            if key in mapping:\n                return mapping[key]\n        raise KeyError(key)\n\n    def get(self, key, default=None):\n        for mapping in self.maps:\n            if key in mapping:\n                return mapping[key]\n        return default\n\n    def _merged(self):\n        merged = \{\}\n        for mapping in reversed(self.maps):\n            for key in mapping:\n                merged[key] = None\n        return merged\n\n    def __len__(self):\n        return len(self._merged())\n\n    def __iter__(self):\n        return iter(self._merged())\n\n    def __contains__(self, key):\n        for mapping in self.maps:\n            if key in mapping:\n                return True\n        return False\n",
        "\n    def __bool__(self):\n        for mapping in self.maps:\n            if mapping:\n                return True\n        return False\n\n    def __repr__(self):\n        return \"%s(%s)\" % (type(self).__name__, \", \".join([repr(m) for m in self.maps]))\n\n    def __eq__(self, other):\n        if isinstance(other, ChainMap):\n            return dict(self.items()) == dict(other.items())\n        if not _is_mapping(other):\n            return False\n        return dict(self.items()) == _plain(other)\n\n    def keys(self):\n        return list(self._merged())\n\n    def values(self):\n        return [self[key] for key in self._merged()]\n\n    def items(self):\n        return [(key, self[key]) for key in self._merged()]\n\n    def copy(self):\n        return ChainMap(self.maps[0].copy(), *self.maps[1:])\n\n    def new_child(self, m=None):\n        \"\"\"A new ChainMap with a new mapping in front of this one's.\"\"\"\n        if m is None:\n            m = \{\}\n        return ChainMap(m, *self.maps)\n\n    @property\n    def parents(self):\n        \"\"\"A ChainMap of every mapping but the first.\"\"\"\n        return ChainMap(*self.maps[1:])\n\n",
        "    def __setitem__(self, key, value):\n        self.maps[0][key] = value\n\n    def __delitem__(self, key):\n        if key not in self.maps[0]:\n            raise KeyError(\"Key not found in the first mapping: %r\" % (key,))\n        del self.maps[0][key]\n\n    def popitem(self):\n        if not self.maps[0]:\n            raise KeyError(\"No keys found in the first mapping.\")\n        return self.maps[0].popitem()\n\n    def pop(self, key, *args):\n        if key not in self.maps[0]:\n            if args:\n                return args[0]\n            raise KeyError(\"Key not found in the first mapping: %r\" % (key,))\n        return self.maps[0].pop(key)\n\n    def clear(self):\n        self.maps[0].clear()\n\n    def update(self, *args, **kwargs):\n        self.maps[0].update(*args, **kwargs)\n\n    def setdefault(self, key, default=None):\n        if key in self:\n            return self[key]\n        self[key] = default\n        return default\n",
    ].joined()
}

fn bundled_copy() -> String {
    [
        "# copy: shallow and deep copies of values.\n#\n# Author: Alexius Academia\n# Date: 2026-10-08\nimport _pytessel\n\n\nclass Error(Exception):\n    __module__ = \"copy\"\n\n\nerror = Error\n\n_ATOMIC = (int, float, bool, str, range, type)\n_ATOMIC_NAMES = (\"NoneType\", \"function\", \"builtin_function_or_method\", \"method\", \"module\")\n\n\ndef _is_atomic(x):\n    # Values that can't change (and functions, classes, modules): a copy\n    # of one is the value itself.\n    return isinstance(x, _ATOMIC) or type(x).__name__ in _ATOMIC_NAMES\n\n\ndef _new_like(x):\n    # An object of x's class, made without calling __init__.\n    return _pytessel.new_instance(type(x))\n\n\ndef copy(x):\n    \"\"\"A new object with the same contents (the contents aren't copied).\"\"\"\n    if isinstance(x, list):\n        return list(x)\n    if isinstance(x, dict):\n        return dict(x)\n    if isinstance(x, set):\n        return set(x)\n    if isinstance(x, tuple) or _is_atomic(x):\n        return x\n    copier = getattr(x, \"__copy__\", None)\n    if copier is not None:\n",
        "        return copier()\n    if not hasattr(x, \"__dict__\"):\n        return x\n    made = _new_like(x)\n    for name in x.__dict__:\n        setattr(made, name, x.__dict__[name])\n    return made\n\n\ndef deepcopy(x, memo=None):\n    \"\"\"A new object whose contents are copies too, all the way down.\"\"\"\n    if memo is None:\n        memo = \{\}\n    if isinstance(x, (list, dict, set, tuple)):\n        key = id(x)\n        if key in memo:\n            return memo[key]\n        if isinstance(x, list):\n            made = []\n            memo[key] = made\n            for item in x:\n                made.append(deepcopy(item, memo))\n            return made\n        if isinstance(x, dict):\n            made = \{\}\n            memo[key] = made\n            for k in x:\n                made[deepcopy(k, memo)] = deepcopy(x[k], memo)\n            return made\n        if isinstance(x, set):\n            made = set()\n            memo[key] = made\n            for item in x:\n                made.add(deepcopy(item, memo))\n            return made\n        items = [deepcopy(item, memo) for item in x]\n        # (A tuple of things that can't change is the tuple itself.)\n        same = True\n        for i in range(len(items)):\n            if items[i] is not x[i]:\n",
        "                same = False\n        made = x if same else tuple(items)\n        memo[key] = made\n        return made\n    if _is_atomic(x):\n        return x\n    key = id(x)\n    if key in memo:\n        return memo[key]\n    copier = getattr(x, \"__deepcopy__\", None)\n    if copier is not None:\n        made = copier(memo)\n        memo[key] = made\n        return made\n    if not hasattr(x, \"__dict__\"):\n        return x\n    made = _new_like(x)\n    memo[key] = made\n    for name in x.__dict__:\n        setattr(made, name, deepcopy(x.__dict__[name], memo))\n    return made\n",
    ].joined()
}

fn bundled_datetime() -> String {
    [
        "# datetime: dates, times of day, moments, and the time between two of them.\n#\n# Author: Alexius Academia\n# Date: 2026-10-08\n#\n# After CPython's own Python version of the module. A date is kept as its\n# year, month and day; a timedelta as days, seconds and microseconds. The\n# clock and the computer's time zone come from the built-in modules time\n# and _pytessel.\nimport time as _time\nimport math as _math\nimport _pytessel\n\nMINYEAR = 1\nMAXYEAR = 9999\n_MAXORDINAL = 3652059\n\n_DAYS_IN_MONTH = [-1, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\n_DAYS_BEFORE_MONTH = [-1, 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334]\n_MONTHNAMES = [None, \"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"]\n_DAYNAMES = [None, \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\", \"Sun\"]\n_FULL_MONTHS = [None, \"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\",\n                \"October\", \"November\", \"December\"]\n_FULL_DAYS = [None, \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"]\n\n\ndef _is_leap(year):\n    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)\n\n\ndef _days_before_year(year):\n    # How many days there are before 1 January of a year.\n    y = year - 1\n    return y * 365 + y // 4 - y // 100 + y // 400\n\n\ndef _days_in_month(year, month):\n    if month == 2 and _is_leap(year):\n        return 29\n    return _DAYS_IN_MONTH[month]\n",
        "\n\ndef _days_before_month(year, month):\n    if month > 2 and _is_leap(year):\n        return _DAYS_BEFORE_MONTH[month] + 1\n    return _DAYS_BEFORE_MONTH[month]\n\n\ndef _ymd2ord(year, month, day):\n    # A date's number: 1 for 1 January of year 1.\n    return _days_before_year(year) + _days_before_month(year, month) + day\n\n\n_DI400Y = _days_before_year(401)\n_DI100Y = _days_before_year(101)\n_DI4Y = _days_before_year(5)\n\n\ndef _ord2ymd(n):\n    # The (year, month, day) of a date's number.\n    n -= 1\n    n400, n = divmod(n, _DI400Y)\n    year = n400 * 400 + 1\n    n100, n = divmod(n, _DI100Y)\n    n4, n = divmod(n, _DI4Y)\n    n1, n = divmod(n, 365)\n    year += n100 * 100 + n4 * 4 + n1\n    if n1 == 4 or n100 == 4:\n        return year - 1, 12, 31\n    leapyear = n1 == 3 and (n4 != 24 or n100 == 3)\n    month = (n + 50) >> 5\n    preceding = _DAYS_BEFORE_MONTH[month] + (1 if month > 2 and leapyear else 0)\n    if preceding > n:\n        month -= 1\n        preceding -= _DAYS_IN_MONTH[month] + (1 if month == 2 and leapyear else 0)\n    n -= preceding\n    return year, month, n + 1\n\n\ndef _type_name(x):\n",
        "    # A value's type as Python's error messages name it.\n    if isinstance(x, datetime):\n        return \"datetime.datetime\"\n    if isinstance(x, date):\n        return \"datetime.date\"\n    if isinstance(x, timedelta):\n        return \"datetime.timedelta\"\n    if isinstance(x, time):\n        return \"datetime.time\"\n    if isinstance(x, timezone):\n        return \"datetime.timezone\"\n    return type(x).__name__\n\n\ndef _unsupported(symbol, a, b):\n    return TypeError(\"unsupported operand type(s) for %s: '%s' and '%s'\" % (symbol, _type_name(a), _type_name(b)))\n\n\ndef _unordered(symbol, a, b):\n    return TypeError(\"'%s' not supported between instances of '%s' and '%s'\" % (symbol, _type_name(a), _type_name(b)))\n\n\ndef _index(value):\n    if isinstance(value, int):\n        return int(value)\n    if isinstance(value, float):\n        raise TypeError(\"integer argument expected, got float\")\n    raise TypeError(\"an integer is required (got type %s)\" % type(value).__name__)\n\n\ndef _check_date_fields(year, month, day):\n    year = _index(year)\n    month = _index(month)\n    day = _index(day)\n    if not MINYEAR <= year <= MAXYEAR:\n        raise ValueError(\"year %d is out of range\" % year)\n    if not 1 <= month <= 12:\n        raise ValueError(\"month must be in 1..12\")\n    if not 1 <= day <= _days_in_month(year, month):\n        raise ValueError(\"day is out of range for month\")\n",
        "    return year, month, day\n\n\ndef _check_time_fields(hour, minute, second, microsecond, fold):\n    hour = _index(hour)\n    minute = _index(minute)\n    second = _index(second)\n    microsecond = _index(microsecond)\n    if not 0 <= hour <= 23:\n        raise ValueError(\"hour must be in 0..23\")\n    if not 0 <= minute <= 59:\n        raise ValueError(\"minute must be in 0..59\")\n    if not 0 <= second <= 59:\n        raise ValueError(\"second must be in 0..59\")\n    if not 0 <= microsecond <= 999999:\n        raise ValueError(\"microsecond must be in 0..999999\")\n    if fold not in (0, 1):\n        raise ValueError(\"fold must be either 0 or 1\")\n    return hour, minute, second, microsecond, fold\n\n\ndef _check_tzinfo(tz):\n    if tz is not None and not isinstance(tz, tzinfo):\n        raise TypeError(\"tzinfo argument must be None or of a tzinfo subclass, not type '%s'\" % type(tz).__name__)\n\n\ndef _cmp(x, y):\n    return 0 if x == y else 1 if x > y else -1\n\n\ndef _divide_and_round(a, b):\n    # a / b, to the nearest whole number (a half goes to the even one).\n    q, r = divmod(a, b)\n    r *= 2\n    greater_than_half = r > b if b > 0 else r < b\n    if greater_than_half or r == b and q % 2 == 1:\n        q += 1\n    return q\n\n\n",
        "_TIME_SPECS = \{\n    \"hours\": \"\{:02d\}\",\n    \"minutes\": \"\{:02d\}:\{:02d\}\",\n    \"seconds\": \"\{:02d\}:\{:02d\}:\{:02d\}\",\n    \"milliseconds\": \"\{:02d\}:\{:02d\}:\{:02d\}.\{:03d\}\",\n    \"microseconds\": \"\{:02d\}:\{:02d\}:\{:02d\}.\{:06d\}\",\n\}\n\n\ndef _format_time(hh, mm, ss, us, timespec=\"auto\"):\n    if timespec == \"auto\":\n        timespec = \"microseconds\" if us else \"seconds\"\n    elif timespec == \"milliseconds\":\n        us = us // 1000\n    if timespec not in _TIME_SPECS:\n        raise ValueError(\"Unknown timespec value\")\n    return _TIME_SPECS[timespec].format(hh, mm, ss, us)\n\n\ndef _format_offset(off, sep=\":\"):\n    # A distance from UTC: +05:30. Nothing for None.\n    if off is None:\n        return \"\"\n    sign = \"+\"\n    if off.days < 0:\n        sign = \"-\"\n        off = -off\n    seconds = off.days * 86400 + off.seconds\n    hh, rest = divmod(seconds, 3600)\n    mm, ss = divmod(rest, 60)\n    s = \"%s%02d%s%02d\" % (sign, hh, sep, mm)\n    if ss or off.microseconds:\n        s += \"%s%02d\" % (sep, ss)\n        if off.microseconds:\n            s += \".%06d\" % off.microseconds\n    return s\n\n\n# ---- strftime ----\n\n",
        "def _strftime(obj, fmt, y, m, d, hh, mi, ss, us):\n    if not isinstance(fmt, str):\n        raise TypeError(\"strftime() argument 1 must be str, not %s\" % type(fmt).__name__)\n    if \"%\" not in fmt:\n        return fmt\n    ordinal = _ymd2ord(y, m, d)\n    weekday = (ordinal + 6) % 7\n    yday = _days_before_month(y, m) + d\n    out = []\n    size = len(fmt)\n    i = 0\n    while i < size:\n        c = fmt[i]\n        i += 1\n        if c != \"%\":\n            out.append(c)\n            continue\n        if i >= size:\n            out.append(\"%\")\n            break\n        c = fmt[i]\n        i += 1\n        if c == \"Y\":\n            out.append(\"%04d\" % y)\n        elif c == \"m\":\n            out.append(\"%02d\" % m)\n        elif c == \"d\":\n            out.append(\"%02d\" % d)\n        elif c == \"H\":\n            out.append(\"%02d\" % hh)\n        elif c == \"M\":\n            out.append(\"%02d\" % mi)\n        elif c == \"S\":\n            out.append(\"%02d\" % ss)\n        elif c == \"f\":\n            out.append(\"%06d\" % us)\n        elif c == \"y\":\n            out.append(\"%02d\" % (y % 100))\n        elif c == \"b\" or c == \"h\":\n            out.append(_MONTHNAMES[m])\n",
        "        elif c == \"B\":\n            out.append(_FULL_MONTHS[m])\n        elif c == \"a\":\n            out.append(_DAYNAMES[weekday + 1])\n        elif c == \"A\":\n            out.append(_FULL_DAYS[weekday + 1])\n        elif c == \"j\":\n            out.append(\"%03d\" % yday)\n        elif c == \"p\":\n            out.append(\"AM\" if hh < 12 else \"PM\")\n        elif c == \"I\":\n            out.append(\"%02d\" % (hh % 12 or 12))\n        elif c == \"%\":\n            out.append(\"%\")\n        elif c == \"z\":\n            off = obj.utcoffset() if hasattr(obj, \"utcoffset\") else None\n            out.append(_format_offset(off, \"\"))\n        elif c == \"Z\":\n            name = obj.tzname() if hasattr(obj, \"tzname\") else None\n            out.append(name or \"\")\n        elif c == \"c\":\n            out.append(\"%s %s %2d %02d:%02d:%02d %04d\" % (_DAYNAMES[weekday + 1], _MONTHNAMES[m], d, hh, mi, ss, y))\n        elif c == \"x\" or c == \"D\":\n            out.append(\"%02d/%02d/%02d\" % (m, d, y % 100))\n        elif c == \"X\" or c == \"T\":\n            out.append(\"%02d:%02d:%02d\" % (hh, mi, ss))\n        elif c == \"R\":\n            out.append(\"%02d:%02d\" % (hh, mi))\n        elif c == \"F\":\n            out.append(\"%04d-%02d-%02d\" % (y, m, d))\n        elif c == \"e\":\n            out.append(\"%2d\" % d)\n        elif c == \"w\":\n            out.append(str((weekday + 1) % 7))\n        elif c == \"u\":\n            out.append(str(weekday + 1))\n        elif c == \"U\":\n            out.append(\"%02d\" % ((yday + 6 - (weekday + 1) % 7) // 7))\n        elif c == \"W\":\n            out.append(\"%02d\" % ((yday + 6 - weekday) // 7))\n",
        "        elif c == \"G\":\n            out.append(\"%04d\" % date(y, m, d).isocalendar()[0])\n        elif c == \"V\":\n            out.append(\"%02d\" % date(y, m, d).isocalendar()[1])\n        elif c == \"C\":\n            out.append(\"%02d\" % (y // 100))\n        elif c == \"n\":\n            out.append(\"\\n\")\n        elif c == \"t\":\n            out.append(\"\\t\")\n        else:\n            out.append(\"%\" + c)\n    return \"\".join(out)\n\n\n# ---- timedelta ----\n\ndef _td_part(value, name):\n    # A part of a timedelta as (whole number, the rest as a float).\n    if isinstance(value, int):\n        return int(value), 0.0\n    if isinstance(value, float):\n        if value != value:\n            raise ValueError(\"cannot convert float NaN to integer\")\n        if value - value != 0.0:\n            raise OverflowError(\"cannot convert float infinity to integer\")\n        whole = int(value)\n        return whole, value - whole\n    raise TypeError(\"unsupported type for timedelta %s component: %s\" % (name, type(value).__name__))\n\n\nclass timedelta:\n    \"\"\"The time between two moments: days, seconds and microseconds.\"\"\"\n\n    __module__ = \"datetime\"\n\n    def __init__(self, days=0, seconds=0, microseconds=0, milliseconds=0, minutes=0, hours=0, weeks=0):\n        d = 0\n        s = 0\n        us = 0\n",
        "        # What's less than a whole unit of a float, in seconds and in microseconds.\n        fs = 0.0\n        fus = 0.0\n        whole, rest = _td_part(days, \"days\")\n        d += whole\n        fs += rest * 86400.0\n        whole, rest = _td_part(weeks, \"weeks\")\n        d += whole * 7\n        fs += rest * 604800.0\n        whole, rest = _td_part(hours, \"hours\")\n        s += whole * 3600\n        fs += rest * 3600.0\n        whole, rest = _td_part(minutes, \"minutes\")\n        s += whole * 60\n        fs += rest * 60.0\n        whole, rest = _td_part(seconds, \"seconds\")\n        s += whole\n        fs += rest\n        # (A float of microseconds is rounded as a whole, with the rest.)\n        if isinstance(milliseconds, float):\n            _td_part(milliseconds, \"milliseconds\")\n            fus += milliseconds * 1000.0\n        else:\n            us += _td_part(milliseconds, \"milliseconds\")[0] * 1000\n        if isinstance(microseconds, float):\n            _td_part(microseconds, \"microseconds\")\n            fus += microseconds\n        else:\n            us += _td_part(microseconds, \"microseconds\")[0]\n        if fs != 0.0:\n            whole = int(fs)\n            s += whole\n            fus += (fs - whole) * 1000000.0\n        if fus != 0.0:\n            if abs(fus) > 8.0e18:\n                raise OverflowError(\"Python int too large to convert to C int\")\n            us += round(fus)\n        carry, us = divmod(us, 1000000)\n        s += carry\n        carry, s = divmod(s, 86400)\n",
        "        d += carry\n        if abs(d) > 999999999:\n            raise OverflowError(\"days=%d; must have magnitude <= 999999999\" % d)\n        self._days = d\n        self._seconds = s\n        self._microseconds = us\n\n    @property\n    def days(self):\n        return self._days\n\n    @property\n    def seconds(self):\n        return self._seconds\n\n    @property\n    def microseconds(self):\n        return self._microseconds\n\n    def _to_microseconds(self):\n        return (self._days * 86400 + self._seconds) * 1000000 + self._microseconds\n\n    def total_seconds(self):\n        \"\"\"The whole of it, in seconds.\"\"\"\n        seconds = self._days * 86400 + self._seconds\n        if self._microseconds == 0:\n            return float(seconds)\n        if abs(self._days) < 100000000:\n            return (seconds * 1000000 + self._microseconds) / 1000000\n        return seconds + self._microseconds / 1000000\n\n    def __repr__(self):\n        args = []\n        if self._days:\n            args.append(\"days=%d\" % self._days)\n        if self._seconds:\n            args.append(\"seconds=%d\" % self._seconds)\n        if self._microseconds:\n            args.append(\"microseconds=%d\" % self._microseconds)\n        if not args:\n",
        "            args.append(\"0\")\n        return \"datetime.timedelta(%s)\" % \", \".join(args)\n\n    def __str__(self):\n        mm, ss = divmod(self._seconds, 60)\n        hh, mm = divmod(mm, 60)\n        s = \"%d:%02d:%02d\" % (hh, mm, ss)\n        if self._days:\n            s = \"%d day%s, \" % (self._days, \"\" if abs(self._days) == 1 else \"s\") + s\n        if self._microseconds:\n            s = s + \".%06d\" % self._microseconds\n        return s\n\n    def __add__(self, other):\n        if isinstance(other, timedelta):\n            return timedelta(self._days + other._days, self._seconds + other._seconds,\n                             self._microseconds + other._microseconds)\n        if isinstance(other, (date, datetime)):\n            return other + self\n        raise _unsupported(\"+\", self, other)\n\n    def __radd__(self, other):\n        raise _unsupported(\"+\", other, self)\n\n    def __sub__(self, other):\n        if isinstance(other, timedelta):\n            return timedelta(self._days - other._days, self._seconds - other._seconds,\n                             self._microseconds - other._microseconds)\n        raise _unsupported(\"-\", self, other)\n\n    def __rsub__(self, other):\n        raise _unsupported(\"-\", other, self)\n\n    def __neg__(self):\n        return timedelta(-self._days, -self._seconds, -self._microseconds)\n\n    def __pos__(self):\n        return self\n\n    def __abs__(self):\n",
        "        if self._days < 0:\n            return -self\n        return self\n\n    def __mul__(self, other):\n        if isinstance(other, int):\n            return timedelta(self._days * other, self._seconds * other, self._microseconds * other)\n        if isinstance(other, float):\n            return timedelta(self._days * other, self._seconds * other, self._microseconds * other)\n        if isinstance(other, (str, list, tuple)):\n            raise TypeError(\"can't multiply sequence by non-int of type 'datetime.timedelta'\")\n        raise _unsupported(\"*\", self, other)\n\n    def __rmul__(self, other):\n        if isinstance(other, (int, float)):\n            return self * other\n        if isinstance(other, (str, list, tuple)):\n            raise TypeError(\"can't multiply sequence by non-int of type 'datetime.timedelta'\")\n        raise _unsupported(\"*\", other, self)\n\n    def __floordiv__(self, other):\n        if isinstance(other, timedelta):\n            theirs = other._to_microseconds()\n            if theirs == 0:\n                raise ZeroDivisionError(\"integer division or modulo by zero\")\n            return self._to_microseconds() // theirs\n        if isinstance(other, int):\n            if other == 0:\n                raise ZeroDivisionError(\"integer division or modulo by zero\")\n            return timedelta(0, 0, self._to_microseconds() // other)\n        raise _unsupported(\"//\", self, other)\n\n    def __truediv__(self, other):\n        if isinstance(other, timedelta):\n            theirs = other._to_microseconds()\n            if theirs == 0:\n                raise ZeroDivisionError(\"division by zero\")\n            return self._to_microseconds() / theirs\n        if isinstance(other, int):\n            if other == 0:\n",
        "                raise ZeroDivisionError(\"integer division or modulo by zero\")\n            return timedelta(0, 0, _divide_and_round(self._to_microseconds(), other))\n        if isinstance(other, float):\n            if other == 0.0:\n                raise ZeroDivisionError(\"float division by zero\")\n            return timedelta(0, 0, self._to_microseconds() / other)\n        raise _unsupported(\"/\", self, other)\n\n    def __mod__(self, other):\n        if isinstance(other, timedelta):\n            theirs = other._to_microseconds()\n            if theirs == 0:\n                raise ZeroDivisionError(\"integer division or modulo by zero\")\n            return timedelta(0, 0, self._to_microseconds() % theirs)\n        raise _unsupported(\"%\", self, other)\n\n    def __divmod__(self, other):\n        if isinstance(other, timedelta):\n            q, r = divmod(self._to_microseconds(), other._to_microseconds())\n            return q, timedelta(0, 0, r)\n        raise _unsupported(\"divmod()\", self, other)\n\n    def _key(self):\n        return (self._days, self._seconds, self._microseconds)\n\n    def __eq__(self, other):\n        return isinstance(other, timedelta) and self._key() == other._key()\n\n    def __ne__(self, other):\n        return not self == other\n\n    def __lt__(self, other):\n        if not isinstance(other, timedelta):\n            raise _unordered(\"<\", self, other)\n        return self._key() < other._key()\n\n    def __le__(self, other):\n        if not isinstance(other, timedelta):\n            raise _unordered(\"<=\", self, other)\n        return self._key() <= other._key()\n",
        "\n    def __gt__(self, other):\n        if not isinstance(other, timedelta):\n            raise _unordered(\">\", self, other)\n        return self._key() > other._key()\n\n    def __ge__(self, other):\n        if not isinstance(other, timedelta):\n            raise _unordered(\">=\", self, other)\n        return self._key() >= other._key()\n\n    def __bool__(self):\n        return self._days != 0 or self._seconds != 0 or self._microseconds != 0\n\n    def __hash__(self):\n        return hash((\"timedelta\", self._days, self._seconds, self._microseconds))\n\n\ntimedelta.min = timedelta(-999999999)\ntimedelta.max = timedelta(days=999999999, hours=23, minutes=59, seconds=59, microseconds=999999)\ntimedelta.resolution = timedelta(microseconds=1)\n\n\n# ---- date ----\n\nclass _IsoCalendarDate:\n    \"\"\"What isocalendar() gives: a (year, week, weekday) with names.\"\"\"\n\n    def __init__(self, year, week, weekday):\n        self.year = year\n        self.week = week\n        self.weekday = weekday\n\n    def _values(self):\n        return (self.year, self.week, self.weekday)\n\n    def __repr__(self):\n        return \"datetime.IsoCalendarDate(year=%d, week=%d, weekday=%d)\" % self._values()\n\n    def __iter__(self):\n",
        "        return iter(self._values())\n\n    def __len__(self):\n        return 3\n\n    def __getitem__(self, index):\n        return self._values()[index]\n\n    def __eq__(self, other):\n        if isinstance(other, _IsoCalendarDate):\n            return self._values() == other._values()\n        return self._values() == other\n\n    def __hash__(self):\n        return hash(self._values())\n\n\ndef _isoweek1monday(year):\n    # The number of the Monday that starts a year's first ISO week.\n    firstday = _ymd2ord(year, 1, 1)\n    firstweekday = (firstday + 6) % 7\n    week1monday = firstday - firstweekday\n    if firstweekday > 3:\n        week1monday += 7\n    return week1monday\n\n\ndef _two_digits(text):\n    if len(text) != 2 or not text.isdigit():\n        raise ValueError(\"not two digits\")\n    return int(text)\n\n\ndef _parse_isoformat_date(text):\n    if len(text) != 10 or text[4] != \"-\" or text[7] != \"-\" or not text[0:4].isdigit():\n        raise ValueError(\"Invalid date\")\n    return [int(text[0:4]), _two_digits(text[5:7]), _two_digits(text[8:10])]\n\n\ndef _parse_hh_mm_ss_ff(text):\n",
        "    size = len(text)\n    parts = [0, 0, 0, 0]\n    pos = 0\n    for part in range(0, 3):\n        if size - pos < 2:\n            raise ValueError(\"Incomplete time component\")\n        parts[part] = _two_digits(text[pos:pos + 2])\n        pos += 2\n        next_char = text[pos:pos + 1]\n        if not next_char or part >= 2:\n            break\n        if next_char != \":\":\n            raise ValueError(\"Invalid time separator: %s\" % next_char)\n        pos += 1\n    if pos < size:\n        if text[pos] != \".\":\n            raise ValueError(\"Invalid microsecond component\")\n        pos += 1\n        rest = text[pos:]\n        if len(rest) not in (3, 6) or not rest.isdigit():\n            raise ValueError(\"Invalid microsecond component\")\n        parts[3] = int(rest)\n        if len(rest) == 3:\n            parts[3] *= 1000\n    return parts\n\n\ndef _parse_isoformat_time(text):\n    # Gives [hour, minute, second, microsecond, tzinfo].\n    if len(text) < 2:\n        raise ValueError(\"Isoformat time too short\")\n    tz_pos = text.find(\"-\") + 1 or text.find(\"+\") + 1\n    timestr = text[:tz_pos - 1] if tz_pos > 0 else text\n    parts = _parse_hh_mm_ss_ff(timestr)\n    tzi = None\n    if tz_pos > 0:\n        tzstr = text[tz_pos:]\n        if len(tzstr) not in (5, 8, 15):\n            raise ValueError(\"Malformed time zone string\")\n        tz_parts = _parse_hh_mm_ss_ff(tzstr)\n",
        "        if tz_parts == [0, 0, 0, 0]:\n            tzi = timezone.utc\n        else:\n            td = timedelta(hours=tz_parts[0], minutes=tz_parts[1], seconds=tz_parts[2], microseconds=tz_parts[3])\n            if text[tz_pos - 1] == \"-\":\n                td = -td\n            tzi = timezone(td)\n    parts.append(tzi)\n    return parts\n\n\nclass date:\n    \"\"\"A day of the calendar: date(2024, 5, 17).\"\"\"\n\n    __module__ = \"datetime\"\n\n    def __init__(self, year, month, day):\n        year, month, day = _check_date_fields(year, month, day)\n        self._year = year\n        self._month = month\n        self._day = day\n\n    @classmethod\n    def fromtimestamp(cls, t):\n        \"\"\"The date, here, of a time in seconds since 1970.\"\"\"\n        seconds = _math.floor(t)\n        seconds += _pytessel.utc_offset(seconds)\n        y, m, d = _ord2ymd(719163 + seconds // 86400)\n        return cls(y, m, d)\n\n    @classmethod\n    def today(cls):\n        return cls.fromtimestamp(_time.time())\n\n    @classmethod\n    def fromordinal(cls, n):\n        \"\"\"The date of a day's number, where 1 January of year 1 is day 1.\"\"\"\n        n = _index(n)\n        if n < 1:\n            raise ValueError(\"ordinal must be >= 1\")\n",
        "        if n > _MAXORDINAL:\n            raise ValueError(\"year %d is out of range\" % (_ord2ymd(n)[0]))\n        y, m, d = _ord2ymd(n)\n        return cls(y, m, d)\n\n    @classmethod\n    def fromisoformat(cls, date_string):\n        \"\"\"A date from the text isoformat() gives: 2024-05-17.\"\"\"\n        if not isinstance(date_string, str):\n            raise TypeError(\"fromisoformat: argument must be str\")\n        try:\n            parts = _parse_isoformat_date(date_string)\n        except ValueError:\n            raise ValueError(\"Invalid isoformat string: %r\" % date_string)\n        return cls(parts[0], parts[1], parts[2])\n\n    @classmethod\n    def fromisocalendar(cls, year, week, day):\n        \"\"\"The date of a year, a week's number and a weekday (1 is Monday).\"\"\"\n        if not MINYEAR <= year <= MAXYEAR:\n            raise ValueError(\"Year is out of range: %d\" % year)\n        if not 0 < week < 53:\n            out_of_range = True\n            if week == 53:\n                first_weekday = _ymd2ord(year, 1, 1) % 7\n                if first_weekday == 4 or (first_weekday == 3 and _is_leap(year)):\n                    out_of_range = False\n            if out_of_range:\n                raise ValueError(\"Invalid week: %d\" % week)\n        if not 0 < day < 8:\n            raise ValueError(\"Invalid weekday: %d (range is [1, 7])\" % day)\n        y, m, d = _ord2ymd(_isoweek1monday(year) + (week - 1) * 7 + day - 1)\n        return cls(y, m, d)\n\n    @property\n    def year(self):\n        return self._year\n\n    @property\n    def month(self):\n",
        "        return self._month\n\n    @property\n    def day(self):\n        return self._day\n\n    def __repr__(self):\n        return \"datetime.date(%d, %d, %d)\" % (self._year, self._month, self._day)\n\n    def ctime(self):\n        weekday = self.toordinal() % 7 or 7\n        return \"%s %s %2d 00:00:00 %04d\" % (_DAYNAMES[weekday], _MONTHNAMES[self._month], self._day, self._year)\n\n    def strftime(self, fmt):\n        \"\"\"The date as text, written the way `fmt` says: %Y-%m-%d.\"\"\"\n        return _strftime(self, fmt, self._year, self._month, self._day, 0, 0, 0, 0)\n\n    def __format__(self, fmt):\n        if not isinstance(fmt, str):\n            raise TypeError(\"must be str, not %s\" % type(fmt).__name__)\n        if len(fmt) != 0:\n            return self.strftime(fmt)\n        return str(self)\n\n    def isoformat(self):\n        return \"%04d-%02d-%02d\" % (self._year, self._month, self._day)\n\n    def __str__(self):\n        return self.isoformat()\n\n    def timetuple(self):\n        \"\"\"(year, month, day, 0, 0, 0, weekday, day of the year, -1).\"\"\"\n        yday = _days_before_month(self._year, self._month) + self._day\n        return (self._year, self._month, self._day, 0, 0, 0, self.weekday(), yday, -1)\n\n    def toordinal(self):\n        \"\"\"The day's number, where 1 January of year 1 is day 1.\"\"\"\n        return _ymd2ord(self._year, self._month, self._day)\n\n    def replace(self, year=None, month=None, day=None):\n",
        "        \"\"\"A date with some of its parts changed.\"\"\"\n        if year is None:\n            year = self._year\n        if month is None:\n            month = self._month\n        if day is None:\n            day = self._day\n        return type(self)(year, month, day)\n\n    def _key(self):\n        return (self._year, self._month, self._day)\n\n    def _other_date(self, other, symbol):\n        # The other side of a comparison, which must be a date too.\n        if isinstance(other, datetime) or isinstance(self, datetime):\n            if isinstance(other, date):\n                raise TypeError(\"can't compare datetime.datetime to datetime.date\")\n        if not isinstance(other, date):\n            raise _unordered(symbol, self, other)\n        return other._key()\n\n    def __eq__(self, other):\n        return isinstance(other, date) and not isinstance(other, datetime) and self._key() == other._key()\n\n    def __ne__(self, other):\n        return not self == other\n\n    def __lt__(self, other):\n        return self._key() < self._other_date(other, \"<\")\n\n    def __le__(self, other):\n        return self._key() <= self._other_date(other, \"<=\")\n\n    def __gt__(self, other):\n        return self._key() > self._other_date(other, \">\")\n\n    def __ge__(self, other):\n        return self._key() >= self._other_date(other, \">=\")\n\n    def __hash__(self):\n",
        "        return hash((\"date\", self._year, self._month, self._day))\n\n    def __add__(self, other):\n        if isinstance(other, timedelta):\n            o = self.toordinal() + other.days\n            if 0 < o <= _MAXORDINAL:\n                return type(self).fromordinal(o)\n            raise OverflowError(\"date value out of range\")\n        raise _unsupported(\"+\", self, other)\n\n    def __radd__(self, other):\n        raise _unsupported(\"+\", other, self)\n\n    def __sub__(self, other):\n        if isinstance(other, timedelta):\n            return self + timedelta(-other.days)\n        if isinstance(other, date) and not isinstance(other, datetime):\n            return timedelta(self.toordinal() - other.toordinal())\n        raise _unsupported(\"-\", self, other)\n\n    def __rsub__(self, other):\n        raise _unsupported(\"-\", other, self)\n\n    def weekday(self):\n        \"\"\"The day of the week: 0 for Monday to 6 for Sunday.\"\"\"\n        return (self.toordinal() + 6) % 7\n\n    def isoweekday(self):\n        \"\"\"The day of the week: 1 for Monday to 7 for Sunday.\"\"\"\n        return self.toordinal() % 7 or 7\n\n    def isocalendar(self):\n        \"\"\"(ISO year, week's number, weekday).\"\"\"\n        year = self._year\n        week1monday = _isoweek1monday(year)\n        today = _ymd2ord(self._year, self._month, self._day)\n        week, day = divmod(today - week1monday, 7)\n        if week < 0:\n            year -= 1\n            week1monday = _isoweek1monday(year)\n",
        "            week, day = divmod(today - week1monday, 7)\n        elif week >= 52:\n            if today >= _isoweek1monday(year + 1):\n                year += 1\n                week = 0\n        return _IsoCalendarDate(year, week + 1, day + 1)\n\n\ndate.min = date(1, 1, 1)\ndate.max = date(9999, 12, 31)\ndate.resolution = timedelta(days=1)\n\n\n# ---- tzinfo and timezone ----\n\nclass tzinfo:\n    \"\"\"A time zone: a class of your own says what utcoffset(), tzname() and dst() are.\"\"\"\n\n    __module__ = \"datetime\"\n\n    def tzname(self, dt):\n        raise NotImplementedError(\"a tzinfo subclass must implement tzname()\")\n\n    def utcoffset(self, dt):\n        raise NotImplementedError(\"a tzinfo subclass must implement utcoffset()\")\n\n    def dst(self, dt):\n        raise NotImplementedError(\"a tzinfo subclass must implement dst()\")\n\n    def fromutc(self, dt):\n        if not isinstance(dt, datetime):\n            raise TypeError(\"fromutc() requires a datetime argument\")\n        if dt.tzinfo is not self:\n            raise ValueError(\"dt.tzinfo is not self\")\n        dtoff = dt.utcoffset()\n        if dtoff is None:\n            raise ValueError(\"fromutc() requires a non-None utcoffset() result\")\n        dtdst = dt.dst()\n        if dtdst is None:\n            raise ValueError(\"fromutc() requires a non-None dst() result\")\n",
        "        delta = dtoff - dtdst\n        if delta:\n            dt += delta\n            dtdst = dt.dst()\n            if dtdst is None:\n                raise ValueError(\"fromutc(): dt.dst gave inconsistent results; cannot convert\")\n        return dt + dtdst\n\n\nclass timezone(tzinfo):\n    \"\"\"A time zone that's always the same distance from UTC.\"\"\"\n\n    __module__ = \"datetime\"\n\n    def __init__(self, offset, name=None):\n        if not isinstance(offset, timedelta):\n            raise TypeError(\"timezone() argument 1 must be datetime.timedelta, not %s\" % type(offset).__name__)\n        if name is not None and not isinstance(name, str):\n            raise TypeError(\"name must be a string\")\n        if not (timedelta(days=-1) < offset and offset < timedelta(days=1)):\n            raise ValueError(\"offset must be a timedelta strictly between -timedelta(hours=24) and \"\n                             \"timedelta(hours=24), not %r.\" % (offset,))\n        self._offset = offset\n        self._name = name\n\n    def __eq__(self, other):\n        return isinstance(other, timezone) and self._offset == other._offset\n\n    def __ne__(self, other):\n        return not self == other\n\n    def __hash__(self):\n        return hash(self._offset)\n\n    def __repr__(self):\n        if self._name is None:\n            if not self._offset:\n                return \"datetime.timezone.utc\"\n            return \"datetime.timezone(%r)\" % (self._offset,)\n        return \"datetime.timezone(%r, %r)\" % (self._offset, self._name)\n",
        "\n    def __str__(self):\n        return self.tzname(None)\n\n    def utcoffset(self, dt):\n        if isinstance(dt, datetime) or dt is None:\n            return self._offset\n        raise TypeError(\"utcoffset() argument must be a datetime instance or None\")\n\n    def tzname(self, dt):\n        if isinstance(dt, datetime) or dt is None:\n            if self._name is None:\n                return self._name_from_offset(self._offset)\n            return self._name\n        raise TypeError(\"tzname() argument must be a datetime instance or None\")\n\n    def dst(self, dt):\n        if isinstance(dt, datetime) or dt is None:\n            return None\n        raise TypeError(\"dst() argument must be a datetime instance or None\")\n\n    def fromutc(self, dt):\n        if isinstance(dt, datetime):\n            if dt.tzinfo is not self:\n                raise ValueError(\"fromutc: dt.tzinfo is not self\")\n            return dt + self._offset\n        raise TypeError(\"fromutc() argument must be a datetime instance or None\")\n\n    def _name_from_offset(self, delta):\n        if not delta:\n            return \"UTC\"\n        return \"UTC\" + _format_offset(delta)\n\n\ntimezone.utc = timezone(timedelta(0))\ntimezone.min = timezone(timedelta(hours=-23, minutes=-59))\ntimezone.max = timezone(timedelta(hours=23, minutes=59))\nUTC = timezone.utc\n\n\n",
        "# ---- time ----\n\nclass time:\n    \"\"\"A time of day: time(13, 30).\"\"\"\n\n    __module__ = \"datetime\"\n\n    def __init__(self, hour=0, minute=0, second=0, microsecond=0, tzinfo=None, fold=0):\n        hour, minute, second, microsecond, fold = _check_time_fields(hour, minute, second, microsecond, fold)\n        _check_tzinfo(tzinfo)\n        self._hour = hour\n        self._minute = minute\n        self._second = second\n        self._microsecond = microsecond\n        self._tzinfo = tzinfo\n        self._fold = fold\n\n    @property\n    def hour(self):\n        return self._hour\n\n    @property\n    def minute(self):\n        return self._minute\n\n    @property\n    def second(self):\n        return self._second\n\n    @property\n    def microsecond(self):\n        return self._microsecond\n\n    @property\n    def tzinfo(self):\n        return self._tzinfo\n\n    @property\n    def fold(self):\n        return self._fold\n",
        "\n    def _key(self):\n        return (self._hour, self._minute, self._second, self._microsecond)\n\n    def _compare(self, other, symbol, equality=False):\n        # -1, 0 or 1, as self is before, the same as or after other\n        # (2 when they can't be compared, and it's only == that asks).\n        if not isinstance(other, time):\n            raise _unordered(symbol, self, other)\n        mytz = self._tzinfo\n        ottz = other._tzinfo\n        myoff = None\n        otoff = None\n        if mytz is ottz:\n            base_compare = True\n        else:\n            myoff = self.utcoffset()\n            otoff = other.utcoffset()\n            base_compare = myoff == otoff\n        if base_compare:\n            return _cmp(self._key(), other._key())\n        if myoff is None or otoff is None:\n            if equality:\n                return 2\n            raise TypeError(\"can't compare offset-naive and offset-aware times\")\n        mine = self._hour * 3600 + self._minute * 60 + self._second - (myoff.days * 86400 + myoff.seconds)\n        theirs = other._hour * 3600 + other._minute * 60 + other._second - (otoff.days * 86400 + otoff.seconds)\n        return _cmp((mine, self._microsecond), (theirs, other._microsecond))\n\n    def __eq__(self, other):\n        return isinstance(other, time) and self._compare(other, \"==\", True) == 0\n\n    def __ne__(self, other):\n        return not self == other\n\n    def __lt__(self, other):\n        return self._compare(other, \"<\") < 0\n\n    def __le__(self, other):\n        return self._compare(other, \"<=\") <= 0\n",
        "\n    def __gt__(self, other):\n        return self._compare(other, \">\") > 0\n\n    def __ge__(self, other):\n        return self._compare(other, \">=\") >= 0\n\n    def __hash__(self):\n        off = self.utcoffset()\n        if off is None:\n            return hash((\"time\", self._hour, self._minute, self._second, self._microsecond))\n        seconds = self._hour * 3600 + self._minute * 60 + self._second - (off.days * 86400 + off.seconds)\n        return hash((\"time at\", seconds % 86400, self._microsecond))\n\n    def __add__(self, other):\n        raise _unsupported(\"+\", self, other)\n\n    def __sub__(self, other):\n        raise _unsupported(\"-\", self, other)\n\n    def __repr__(self):\n        if self._microsecond != 0:\n            s = \", %d, %d\" % (self._second, self._microsecond)\n        elif self._second != 0:\n            s = \", %d\" % self._second\n        else:\n            s = \"\"\n        s = \"datetime.time(%d, %d%s)\" % (self._hour, self._minute, s)\n        if self._tzinfo is not None:\n            s = s[:len(s) - 1] + \", tzinfo=%r\" % (self._tzinfo,) + \")\"\n        if self._fold:\n            s = s[:len(s) - 1] + \", fold=1)\"\n        return s\n\n    def isoformat(self, timespec=\"auto\"):\n        \"\"\"The time as text: 13:30:00, with .ffffff and +HH:MM when there are any.\"\"\"\n        s = _format_time(self._hour, self._minute, self._second, self._microsecond, timespec)\n        return s + _format_offset(self.utcoffset())\n\n    def __str__(self):\n",
        "        return self.isoformat()\n\n    @classmethod\n    def fromisoformat(cls, time_string):\n        \"\"\"A time from the text isoformat() gives.\"\"\"\n        if not isinstance(time_string, str):\n            raise TypeError(\"fromisoformat: argument must be str\")\n        try:\n            parts = _parse_isoformat_time(time_string)\n        except ValueError:\n            raise ValueError(\"Invalid isoformat string: %r\" % time_string)\n        return cls(parts[0], parts[1], parts[2], parts[3], parts[4])\n\n    def strftime(self, fmt):\n        \"\"\"The time as text, written the way `fmt` says: %H:%M.\"\"\"\n        return _strftime(self, fmt, 1900, 1, 1, self._hour, self._minute, self._second, self._microsecond)\n\n    def __format__(self, fmt):\n        if len(fmt) != 0:\n            return self.strftime(fmt)\n        return str(self)\n\n    def utcoffset(self):\n        if self._tzinfo is None:\n            return None\n        return self._tzinfo.utcoffset(None)\n\n    def tzname(self):\n        if self._tzinfo is None:\n            return None\n        return self._tzinfo.tzname(None)\n\n    def dst(self):\n        if self._tzinfo is None:\n            return None\n        return self._tzinfo.dst(None)\n\n    def replace(self, hour=None, minute=None, second=None, microsecond=None, tzinfo=True, fold=None):\n        \"\"\"A time with some of its parts changed.\"\"\"\n        if hour is None:\n",
        "            hour = self._hour\n        if minute is None:\n            minute = self._minute\n        if second is None:\n            second = self._second\n        if microsecond is None:\n            microsecond = self._microsecond\n        if tzinfo is True:\n            tzinfo = self._tzinfo\n        if fold is None:\n            fold = self._fold\n        return type(self)(hour, minute, second, microsecond, tzinfo, fold)\n\n\ntime.min = time(0, 0, 0)\ntime.max = time(23, 59, 59, 999999)\ntime.resolution = timedelta(microseconds=1)\n\n\n# ---- datetime ----\n\nclass datetime(date):\n    \"\"\"A moment: a date and a time of day. datetime(2024, 5, 17, 13, 30).\"\"\"\n\n    __module__ = \"datetime\"\n\n    def __init__(self, year, month, day, hour=0, minute=0, second=0, microsecond=0, tzinfo=None, fold=0):\n        year, month, day = _check_date_fields(year, month, day)\n        hour, minute, second, microsecond, fold = _check_time_fields(hour, minute, second, microsecond, fold)\n        _check_tzinfo(tzinfo)\n        self._year = year\n        self._month = month\n        self._day = day\n        self._hour = hour\n        self._minute = minute\n        self._second = second\n        self._microsecond = microsecond\n        self._tzinfo = tzinfo\n        self._fold = fold\n\n",
        "    @property\n    def hour(self):\n        return self._hour\n\n    @property\n    def minute(self):\n        return self._minute\n\n    @property\n    def second(self):\n        return self._second\n\n    @property\n    def microsecond(self):\n        return self._microsecond\n\n    @property\n    def tzinfo(self):\n        return self._tzinfo\n\n    @property\n    def fold(self):\n        return self._fold\n\n    @classmethod\n    def _from_seconds(cls, seconds, us, tz):\n        # The datetime that many seconds after the start of 1970.\n        days, rest = divmod(seconds, 86400)\n        ordinal = 719163 + days\n        if ordinal < 1 or ordinal > _MAXORDINAL:\n            raise ValueError(\"year %d is out of range\" % (1970 + seconds // 31556952))\n        y, m, d = _ord2ymd(ordinal)\n        hh, rest = divmod(rest, 3600)\n        mm, ss = divmod(rest, 60)\n        return cls(y, m, d, hh, mm, ss, us, tz)\n\n    @classmethod\n    def _split_timestamp(cls, t):\n        # A time as (whole seconds, microseconds).\n        if not isinstance(t, (int, float)):\n",
        "            raise TypeError(\"an integer is required (got type %s)\" % type(t).__name__)\n        if isinstance(t, int):\n            return int(t), 0\n        if t != t:\n            raise ValueError(\"Invalid value NaN (not a number)\")\n        if t > 1.0e14 or t < -1.0e14:\n            raise OverflowError(\"timestamp out of range for platform time_t\")\n        seconds = _math.floor(t)\n        us = round((t - seconds) * 1000000.0)\n        if us >= 1000000:\n            seconds += 1\n            us -= 1000000\n        return seconds, us\n\n    @classmethod\n    def fromtimestamp(cls, t, tz=None):\n        \"\"\"The datetime of a time in seconds since 1970: here, or in the time zone `tz`.\"\"\"\n        _check_tzinfo(tz)\n        seconds, us = cls._split_timestamp(t)\n        if tz is None:\n            return cls._from_seconds(seconds + _pytessel.utc_offset(seconds), us, None)\n        return tz.fromutc(cls._from_seconds(seconds, us, tz))\n\n    @classmethod\n    def utcfromtimestamp(cls, t):\n        \"\"\"The datetime, at UTC, of a time in seconds since 1970 (with no time zone).\"\"\"\n        seconds, us = cls._split_timestamp(t)\n        return cls._from_seconds(seconds, us, None)\n\n    @classmethod\n    def now(cls, tz=None):\n        \"\"\"The date and time it is now.\"\"\"\n        return cls.fromtimestamp(_time.time(), tz)\n\n    @classmethod\n    def today(cls):\n        return cls.fromtimestamp(_time.time())\n\n    @classmethod\n    def utcnow(cls):\n",
        "        return cls.utcfromtimestamp(_time.time())\n\n    @classmethod\n    def fromordinal(cls, n):\n        n = _index(n)\n        if n < 1:\n            raise ValueError(\"ordinal must be >= 1\")\n        if n > _MAXORDINAL:\n            raise ValueError(\"year %d is out of range\" % (_ord2ymd(n)[0]))\n        y, m, d = _ord2ymd(n)\n        return cls(y, m, d)\n\n    @classmethod\n    def combine(cls, date, time, tzinfo=True):\n        \"\"\"A datetime from a date and a time.\"\"\"\n        if not isinstance(date, _date_class):\n            raise TypeError(\"combine() argument 1 must be datetime.date, not %s\" % type(date).__name__)\n        if not isinstance(time, _time_class):\n            raise TypeError(\"combine() argument 2 must be datetime.time, not %s\" % type(time).__name__)\n        if tzinfo is True:\n            tzinfo = time.tzinfo\n        return cls(date.year, date.month, date.day, time.hour, time.minute, time.second, time.microsecond,\n                   tzinfo, time.fold)\n\n    @classmethod\n    def fromisoformat(cls, date_string):\n        \"\"\"A datetime from the text isoformat() gives: 2024-05-17T13:30:00.\"\"\"\n        if not isinstance(date_string, str):\n            raise TypeError(\"fromisoformat: argument must be str\")\n        try:\n            if len(date_string) == 11:\n                raise ValueError(\"no time after the separator\")\n            parts = _parse_isoformat_date(date_string[0:10])\n            rest = date_string[11:]\n            if rest:\n                parts = parts + _parse_isoformat_time(rest)\n            else:\n                parts = parts + [0, 0, 0, 0, None]\n        except ValueError:\n            raise ValueError(\"Invalid isoformat string: %r\" % date_string)\n",
        "        return cls(parts[0], parts[1], parts[2], parts[3], parts[4], parts[5], parts[6], parts[7])\n\n    @classmethod\n    def strptime(cls, date_string, format):\n        \"\"\"A datetime read from a text written the way `format` says.\"\"\"\n        return _strptime(cls, date_string, format)\n\n    def timetuple(self):\n        \"\"\"(year, month, day, hour, minute, second, weekday, day of the year, -1).\"\"\"\n        yday = _days_before_month(self._year, self._month) + self._day\n        return (self._year, self._month, self._day, self._hour, self._minute, self._second, self.weekday(), yday, -1)\n\n    def _local_timezone(self):\n        if self._tzinfo is None:\n            seconds = self._mktime()\n        else:\n            delta = self - _EPOCH\n            seconds = delta.days * 86400 + delta.seconds\n        return timezone(timedelta(seconds=_pytessel.utc_offset(seconds)))\n\n    def _mktime(self):\n        # The seconds since 1970 of a datetime that's in the computer's time zone.\n        t = (self.toordinal() - 719163) * 86400 + self._hour * 3600 + self._minute * 60 + self._second\n        a = _pytessel.utc_offset(t)\n        u1 = t - a\n        t1 = u1 + _pytessel.utc_offset(u1)\n        if t1 == t:\n            # (Twice the same time, when the clocks go back: `fold` says which.)\n            u2 = u1 + (86400 if self._fold else -86400)\n            b = _pytessel.utc_offset(u2)\n            if a == b:\n                return u1\n        else:\n            b = t1 - u1\n        u2 = t - b\n        t2 = u2 + _pytessel.utc_offset(u2)\n        if t2 == t:\n            return u2\n        if t1 == t:\n            return u1\n",
        "        if self._fold:\n            return min(u1, u2)\n        return max(u1, u2)\n\n    def timestamp(self):\n        \"\"\"The seconds since the start of 1970 (UTC), as a float.\"\"\"\n        if self._tzinfo is None:\n            return self._mktime() + self._microsecond / 1000000\n        return (self - _EPOCH).total_seconds()\n\n    def utctimetuple(self):\n        offset = self.utcoffset()\n        if offset:\n            return (self - offset).timetuple()\n        return self.timetuple()\n\n    def date(self):\n        \"\"\"The date part.\"\"\"\n        return _date_class(self._year, self._month, self._day)\n\n    def time(self):\n        \"\"\"The time part, without the time zone.\"\"\"\n        return _time_class(self._hour, self._minute, self._second, self._microsecond, None, self._fold)\n\n    def timetz(self):\n        \"\"\"The time part, with the time zone.\"\"\"\n        return _time_class(self._hour, self._minute, self._second, self._microsecond, self._tzinfo, self._fold)\n\n    def replace(self, year=None, month=None, day=None, hour=None, minute=None, second=None, microsecond=None,\n                tzinfo=True, fold=None):\n        \"\"\"A datetime with some of its parts changed.\"\"\"\n        if year is None:\n            year = self._year\n        if month is None:\n            month = self._month\n        if day is None:\n            day = self._day\n        if hour is None:\n            hour = self._hour\n        if minute is None:\n",
        "            minute = self._minute\n        if second is None:\n            second = self._second\n        if microsecond is None:\n            microsecond = self._microsecond\n        if tzinfo is True:\n            tzinfo = self._tzinfo\n        if fold is None:\n            fold = self._fold\n        return type(self)(year, month, day, hour, minute, second, microsecond, tzinfo, fold)\n\n    def astimezone(self, tz=None):\n        \"\"\"The same moment, as another time zone's clock shows it.\"\"\"\n        if tz is None:\n            tz = self._local_timezone()\n        elif not isinstance(tz, _tzinfo_class):\n            raise TypeError(\"tz argument must be an instance of tzinfo\")\n        mytz = self._tzinfo\n        if mytz is None:\n            mytz = self._local_timezone()\n            myoffset = mytz.utcoffset(self)\n        else:\n            myoffset = mytz.utcoffset(self)\n            if myoffset is None:\n                mytz = self.replace(tzinfo=None)._local_timezone()\n                myoffset = mytz.utcoffset(self)\n        if tz is mytz:\n            return self\n        utc = (self - myoffset).replace(tzinfo=tz)\n        return tz.fromutc(utc)\n\n    def ctime(self):\n        weekday = self.toordinal() % 7 or 7\n        return \"%s %s %2d %02d:%02d:%02d %04d\" % (_DAYNAMES[weekday], _MONTHNAMES[self._month], self._day,\n                                                 self._hour, self._minute, self._second, self._year)\n\n    def isoformat(self, sep=\"T\", timespec=\"auto\"):\n        \"\"\"The datetime as text: 2024-05-17T13:30:00.\"\"\"\n        s = \"%04d-%02d-%02d\" % (self._year, self._month, self._day) + sep\n        s += _format_time(self._hour, self._minute, self._second, self._microsecond, timespec)\n",
        "        return s + _format_offset(self.utcoffset())\n\n    def __repr__(self):\n        parts = [self._year, self._month, self._day, self._hour, self._minute, self._second, self._microsecond]\n        if parts[6] == 0:\n            parts.pop()\n            if parts[5] == 0:\n                parts.pop()\n        s = \"datetime.datetime(%s)\" % \", \".join([str(p) for p in parts])\n        if self._tzinfo is not None:\n            s = s[:len(s) - 1] + \", tzinfo=%r\" % (self._tzinfo,) + \")\"\n        if self._fold:\n            s = s[:len(s) - 1] + \", fold=1)\"\n        return s\n\n    def __str__(self):\n        return self.isoformat(\" \")\n\n    def strftime(self, fmt):\n        \"\"\"The datetime as text, written the way `fmt` says: %Y-%m-%d %H:%M.\"\"\"\n        return _strftime(self, fmt, self._year, self._month, self._day, self._hour, self._minute, self._second,\n                         self._microsecond)\n\n    def utcoffset(self):\n        \"\"\"How far from UTC its time zone is, as a timedelta (None with no time zone).\"\"\"\n        if self._tzinfo is None:\n            return None\n        return self._tzinfo.utcoffset(self)\n\n    def tzname(self):\n        if self._tzinfo is None:\n            return None\n        return self._tzinfo.tzname(self)\n\n    def dst(self):\n        if self._tzinfo is None:\n            return None\n        return self._tzinfo.dst(self)\n\n    def _key(self):\n",
        "        return (self._year, self._month, self._day, self._hour, self._minute, self._second, self._microsecond)\n\n    def _compare(self, other, symbol, equality=False):\n        if not isinstance(other, datetime):\n            if isinstance(other, date):\n                raise TypeError(\"can't compare datetime.datetime to datetime.date\")\n            raise _unordered(symbol, self, other)\n        mytz = self._tzinfo\n        ottz = other._tzinfo\n        myoff = None\n        otoff = None\n        if mytz is ottz:\n            base_compare = True\n        else:\n            myoff = self.utcoffset()\n            otoff = other.utcoffset()\n            base_compare = myoff == otoff\n        if base_compare:\n            return _cmp(self._key(), other._key())\n        if myoff is None or otoff is None:\n            if equality:\n                return 2\n            raise TypeError(\"can't compare offset-naive and offset-aware datetimes\")\n        diff = self - other\n        if diff.days < 0:\n            return -1\n        return 1 if diff else 0\n\n    def __eq__(self, other):\n        return isinstance(other, datetime) and self._compare(other, \"==\", True) == 0\n\n    def __ne__(self, other):\n        return not self == other\n\n    def __lt__(self, other):\n        return self._compare(other, \"<\") < 0\n\n    def __le__(self, other):\n        return self._compare(other, \"<=\") <= 0\n\n",
        "    def __gt__(self, other):\n        return self._compare(other, \">\") > 0\n\n    def __ge__(self, other):\n        return self._compare(other, \">=\") >= 0\n\n    def __add__(self, other):\n        if not isinstance(other, timedelta):\n            raise _unsupported(\"+\", self, other)\n        days = self.toordinal() + other.days\n        seconds = self._hour * 3600 + self._minute * 60 + self._second + other.seconds\n        us = self._microsecond + other.microseconds\n        carry, us = divmod(us, 1000000)\n        seconds += carry\n        carry, seconds = divmod(seconds, 86400)\n        days += carry\n        if not 0 < days <= _MAXORDINAL:\n            raise OverflowError(\"date value out of range\")\n        y, m, d = _ord2ymd(days)\n        hh, rest = divmod(seconds, 3600)\n        mm, ss = divmod(rest, 60)\n        return type(self)(y, m, d, hh, mm, ss, us, self._tzinfo)\n\n    def __radd__(self, other):\n        raise _unsupported(\"+\", other, self)\n\n    def __sub__(self, other):\n        if not isinstance(other, datetime):\n            if isinstance(other, timedelta):\n                return self + -other\n            raise _unsupported(\"-\", self, other)\n        secs1 = self._second + self._minute * 60 + self._hour * 3600\n        secs2 = other._second + other._minute * 60 + other._hour * 3600\n        base = timedelta(self.toordinal() - other.toordinal(), secs1 - secs2, self._microsecond - other._microsecond)\n        if self._tzinfo is other._tzinfo:\n            return base\n        myoff = self.utcoffset()\n        otoff = other.utcoffset()\n        if myoff == otoff:\n            return base\n",
        "        if myoff is None or otoff is None:\n            raise TypeError(\"can't subtract offset-naive and offset-aware datetimes\")\n        return base + otoff - myoff\n\n    def __rsub__(self, other):\n        raise _unsupported(\"-\", other, self)\n\n    def __hash__(self):\n        off = self.utcoffset()\n        if off is None:\n            return hash((\"datetime\", self._year, self._month, self._day, self._hour, self._minute, self._second,\n                         self._microsecond))\n        seconds = self._hour * 3600 + self._minute * 60 + self._second\n        at_utc = timedelta(self.toordinal(), seconds, self._microsecond) - off\n        return hash((\"datetime at\", at_utc.days, at_utc.seconds, at_utc.microseconds))\n\n\n# (Inside datetime, `date` and `time` are its own methods.)\n_date_class = date\n_time_class = time\n_tzinfo_class = tzinfo\n\ndatetime.min = datetime(1, 1, 1)\ndatetime.max = datetime(9999, 12, 31, 23, 59, 59, 999999)\ndatetime.resolution = timedelta(microseconds=1)\n_EPOCH = datetime(1970, 1, 1, tzinfo=timezone.utc)\n\n\n# ---- strptime ----\n\ndef _names_pattern(group, names):\n    # (name|name|…), the longest names first.\n    ordered = sorted([n.lower() for n in names if n], key=len, reverse=True)\n    return \"(?P<%s>%s)\" % (group, \"|\".join(ordered))\n\n\n_STRPTIME_PARTS = \{\n    \"d\": r\"(?P<d>3[0-1]|[1-2]\\d|0[1-9]|[1-9]| [1-9])\",\n    \"f\": r\"(?P<f>[0-9]\{1,6\})\",\n    \"H\": r\"(?P<H>2[0-3]|[0-1]\\d|\\d)\",\n",
        "    \"I\": r\"(?P<I>1[0-2]|0[1-9]|[1-9])\",\n    \"j\": r\"(?P<j>36[0-6]|3[0-5]\\d|[1-2]\\d\\d|0[1-9]\\d|00[1-9]|[1-9]\\d|0[1-9]|[1-9])\",\n    \"m\": r\"(?P<m>1[0-2]|0[1-9]|[1-9])\",\n    \"M\": r\"(?P<M>[0-5]\\d|\\d)\",\n    \"S\": r\"(?P<S>6[0-1]|[0-5]\\d|\\d)\",\n    \"w\": r\"(?P<w>[0-6])\",\n    \"u\": r\"(?P<u>[1-7])\",\n    \"y\": r\"(?P<y>\\d\\d)\",\n    \"Y\": r\"(?P<Y>\\d\\d\\d\\d)\",\n    \"z\": r\"(?P<z>[+-]\\d\\d:?[0-5]\\d(:?[0-5]\\d(\\.\\d\{1,6\})?)?|(?-i:Z))\",\n    \"A\": _names_pattern(\"A\", _FULL_DAYS),\n    \"a\": _names_pattern(\"a\", _DAYNAMES),\n    \"B\": _names_pattern(\"B\", _FULL_MONTHS),\n    \"b\": _names_pattern(\"b\", _MONTHNAMES),\n    \"p\": \"(?P<p>am|pm)\",\n    \"Z\": \"(?P<Z>utc|gmt)\",\n    \"%\": \"%\",\n\}\n\n_strptime_cache = \{\}\n\n\ndef _strptime_pattern(format):\n    import re\n    # %c, %x and %X are other directives put together.\n    given = format\n    format = format.replace(\"%%\", \"\\x00\").replace(\"%c\", \"%a %b %d %H:%M:%S %Y\").replace(\"%x\", \"%m/%d/%y\")\n    format = format.replace(\"%X\", \"%H:%M:%S\").replace(\"\\x00\", \"%%\")\n    parts = []\n    size = len(format)\n    i = 0\n    while i < size:\n        c = format[i]\n        if c == \"%\":\n            if i + 1 >= size:\n                raise ValueError(\"stray %% in format '%s'\" % given)\n            directive = format[i + 1]\n            i += 2\n            if directive not in _STRPTIME_PARTS:\n                raise ValueError(\"'%s' is a bad directive in format '%s'\" % (directive, given))\n",
        "            parts.append(_STRPTIME_PARTS[directive])\n        elif c in \" \\t\\n\\r\\x0b\\x0c\":\n            while i < size and format[i] in \" \\t\\n\\r\\x0b\\x0c\":\n                i += 1\n            parts.append(\"\\\\s+\")\n        else:\n            parts.append(re.escape(c))\n            i += 1\n    return re.compile(\"\".join(parts), re.IGNORECASE)\n\n\ndef _strptime(cls, data_string, format):\n    if not isinstance(data_string, str):\n        raise TypeError(\"strptime() argument 1 must be str, not %s\" % type(data_string).__name__)\n    if not isinstance(format, str):\n        raise TypeError(\"strptime() argument 2 must be str, not %s\" % type(format).__name__)\n    pattern = _strptime_cache.get(format)\n    if pattern is None:\n        pattern = _strptime_pattern(format)\n        _strptime_cache[format] = pattern\n    found = pattern.match(data_string)\n    if not found:\n        raise ValueError(\"time data %r does not match format %r\" % (data_string, format))\n    if len(data_string) != found.end():\n        raise ValueError(\"unconverted data remains: %s\" % data_string[found.end():])\n    year = 1900\n    month = 1\n    day = 1\n    hour = 0\n    minute = 0\n    second = 0\n    fraction = 0\n    julian = None\n    gmtoff = None\n    gmtoff_fraction = 0\n    tzname = None\n    groups = found.groupdict()\n    for key in groups:\n        text = groups[key]\n        if text is None:\n",
        "            continue\n        if key == \"y\":\n            year = int(text)\n            # (Two digits: 69 to 99 are 1969 to 1999, 00 to 68 are 2000 to 2068.)\n            if year <= 68:\n                year += 2000\n            else:\n                year += 1900\n        elif key == \"Y\":\n            year = int(text)\n        elif key == \"m\":\n            month = int(text)\n        elif key == \"B\":\n            month = [n.lower() if n else n for n in _FULL_MONTHS].index(text.lower())\n        elif key == \"b\":\n            month = [n.lower() if n else n for n in _MONTHNAMES].index(text.lower())\n        elif key == \"d\":\n            day = int(text)\n        elif key == \"H\":\n            hour = int(text)\n        elif key == \"I\":\n            hour = int(text)\n            ampm = (groups.get(\"p\") or \"\").lower()\n            if ampm in (\"\", \"am\"):\n                if hour == 12:\n                    hour = 0\n            elif hour != 12:\n                hour += 12\n        elif key == \"M\":\n            minute = int(text)\n        elif key == \"S\":\n            second = int(text)\n        elif key == \"f\":\n            fraction = int(text + \"0\" * (6 - len(text)))\n        elif key == \"j\":\n            julian = int(text)\n        elif key == \"z\":\n            z = text\n            if z == \"Z\":\n                gmtoff = 0\n",
        "            else:\n                if z[3] == \":\":\n                    z = z[:3] + z[4:]\n                    if len(z) > 5:\n                        if z[5] != \":\":\n                            raise ValueError(\"Inconsistent use of : in %s\" % text)\n                        z = z[:5] + z[6:]\n                gmtoff = int(z[1:3]) * 3600 + int(z[3:5]) * 60 + int(z[5:7] or 0)\n                rest = z[8:]\n                gmtoff_fraction = int(rest + \"0\" * (6 - len(rest)))\n                if z.startswith(\"-\"):\n                    gmtoff = -gmtoff\n                    gmtoff_fraction = -gmtoff_fraction\n        elif key == \"Z\":\n            tzname = text\n    if julian is not None:\n        found_date = date.fromordinal(julian - 1 + _ymd2ord(year, 1, 1))\n        year = found_date.year\n        month = found_date.month\n        day = found_date.day\n    tz = None\n    if gmtoff is not None:\n        delta = timedelta(seconds=gmtoff, microseconds=gmtoff_fraction)\n        if tzname:\n            tz = timezone(delta, tzname)\n        else:\n            tz = timezone(delta)\n    return cls(year, month, day, hour, minute, second, fraction, tz)\n",
    ].joined()
}

fn bundled_functools() -> String {
    [
        "# functools: functions that work on functions.\n#\n# Author: Alexius Academia\n# Date: 2026-10-08\nfrom _functools import reduce\n\nWRAPPER_ASSIGNMENTS = (\"__module__\", \"__name__\", \"__qualname__\", \"__doc__\")\nWRAPPER_UPDATES = (\"__dict__\",)\n\n\ndef update_wrapper(wrapper, wrapped, assigned=WRAPPER_ASSIGNMENTS, updated=WRAPPER_UPDATES):\n    \"\"\"Makes a wrapper function look like the function it wraps.\"\"\"\n    for attr in assigned:\n        try:\n            value = getattr(wrapped, attr)\n        except AttributeError:\n            pass\n        else:\n            setattr(wrapper, attr, value)\n    for attr in updated:\n        extra = getattr(wrapped, attr, None)\n        if extra:\n            for name in extra:\n                if name not in assigned:\n                    setattr(wrapper, name, extra[name])\n    wrapper.__wrapped__ = wrapped\n    return wrapper\n\n\ndef wraps(wrapped, assigned=WRAPPER_ASSIGNMENTS, updated=WRAPPER_UPDATES):\n    \"\"\"A decorator for a wrapper function: @wraps(f) gives it f's name.\"\"\"\n    def decorator(wrapper):\n        return update_wrapper(wrapper, wrapped, assigned, updated)\n    return decorator\n\n\nclass partial:\n    \"\"\"A function with some of its arguments already given.\"\"\"\n\n    __module__ = \"functools\"\n",
        "\n    def __init__(self, *args, **keywords):\n        if not args:\n            raise TypeError(\"type 'partial' takes at least one argument\")\n        func = args[0]\n        args = tuple(args[1:])\n        if not callable(func):\n            raise TypeError(\"the first argument must be callable\")\n        if isinstance(func, partial):\n            args = func.args + args\n            merged = dict(func.keywords)\n            merged.update(keywords)\n            keywords = merged\n            func = func.func\n        self.func = func\n        self.args = args\n        self.keywords = keywords\n\n    def __call__(self, *args, **keywords):\n        merged = dict(self.keywords)\n        merged.update(keywords)\n        return self.func(*self.args, *args, **merged)\n\n    def __repr__(self):\n        parts = [repr(self.func)]\n        for a in self.args:\n            parts.append(repr(a))\n        for k in self.keywords:\n            parts.append(\"%s=%r\" % (k, self.keywords[k]))\n        return \"functools.partial(%s)\" % \", \".join(parts)\n\n\nclass _CacheInfo:\n    def __init__(self, hits, misses, maxsize, currsize):\n        self.hits = hits\n        self.misses = misses\n        self.maxsize = maxsize\n        self.currsize = currsize\n\n    def __repr__(self):\n",
        "        return \"CacheInfo(hits=%r, misses=%r, maxsize=%r, currsize=%r)\" % (self.hits, self.misses, self.maxsize, self.currsize)\n\n    def __iter__(self):\n        return iter((self.hits, self.misses, self.maxsize, self.currsize))\n\n    def __getitem__(self, index):\n        return (self.hits, self.misses, self.maxsize, self.currsize)[index]\n\n    def __eq__(self, other):\n        return tuple(self) == tuple(other)\n\n\ndef _make_key(args, keywords, typed):\n    key = args\n    if keywords:\n        key = key + (\"<keywords>\",)\n        for name in keywords:\n            key = key + (name, keywords[name])\n    if typed:\n        key = key + tuple([type(v) for v in args])\n        if keywords:\n            key = key + tuple([type(keywords[name]) for name in keywords])\n    return key\n\n\ndef _lru_cache_wrapper(user_function, maxsize, typed):\n    # The results, oldest first: a dictionary keeps the order its keys\n    # were added in, so the first key is the least recently used one.\n    cache = \{\}\n    counts = [0, 0]\n\n    def wrapper(*args, **keywords):\n        if maxsize == 0:\n            counts[1] += 1\n            return user_function(*args, **keywords)\n        key = _make_key(args, keywords, typed)\n        if key in cache:\n            counts[0] += 1\n            result = cache[key]\n            if maxsize is not None:\n",
        "                # (Used just now: it goes to the end.)\n                del cache[key]\n                cache[key] = result\n            return result\n        counts[1] += 1\n        result = user_function(*args, **keywords)\n        cache[key] = result\n        if maxsize is not None and len(cache) > maxsize:\n            for oldest in cache:\n                break\n            del cache[oldest]\n        return result\n\n    def cache_info():\n        return _CacheInfo(counts[0], counts[1], maxsize, len(cache))\n\n    def cache_clear():\n        cache.clear()\n        counts[0] = 0\n        counts[1] = 0\n\n    def cache_parameters():\n        return \{\"maxsize\": maxsize, \"typed\": typed\}\n\n    wrapper.cache_info = cache_info\n    wrapper.cache_clear = cache_clear\n    wrapper.cache_parameters = cache_parameters\n    return update_wrapper(wrapper, user_function)\n\n\ndef lru_cache(maxsize=128, typed=False):\n    \"\"\"Keeps a function's results: @lru_cache, @lru_cache(), @lru_cache(maxsize=None).\"\"\"\n    if isinstance(maxsize, int):\n        if maxsize < 0:\n            maxsize = 0\n    elif callable(maxsize) and isinstance(typed, bool):\n        # @lru_cache with no parentheses: `maxsize` is the function.\n        return _lru_cache_wrapper(maxsize, 128, typed)\n    elif maxsize is not None:\n        raise TypeError(\"Expected first argument to be an integer, a callable, or None\")\n",
        "\n    def decorating_function(user_function):\n        return _lru_cache_wrapper(user_function, maxsize, typed)\n\n    return decorating_function\n\n\ndef cache(user_function):\n    \"\"\"Keeps every result of a function: the same as lru_cache(maxsize=None).\"\"\"\n    return lru_cache(maxsize=None)(user_function)\n\n\ndef cmp_to_key(mycmp):\n    \"\"\"A key function for sorted() from an old-style comparison function.\"\"\"\n\n    class K:\n        def __init__(self, obj):\n            self.obj = obj\n\n        def __lt__(self, other):\n            return mycmp(self.obj, other.obj) < 0\n\n        def __gt__(self, other):\n            return mycmp(self.obj, other.obj) > 0\n\n        def __eq__(self, other):\n            return mycmp(self.obj, other.obj) == 0\n\n        def __le__(self, other):\n            return mycmp(self.obj, other.obj) <= 0\n\n        def __ge__(self, other):\n            return mycmp(self.obj, other.obj) >= 0\n\n    return K\n\n\ndef _has(cls, name):\n    # (Defined by the class or one it inherits from: not what `object` gives.)\n    return getattr(cls, name, None) is not None\n",
        "\n\ndef total_ordering(cls):\n    \"\"\"A class decorator: from __eq__ and one of < <= > >=, the other three.\"\"\"\n    defined = [op for op in (\"__lt__\", \"__le__\", \"__gt__\", \"__ge__\") if _has(cls, op)]\n    if not defined:\n        raise ValueError(\"must define at least one ordering operation: < > <= >=\")\n    root = defined[0]\n    if root == \"__lt__\":\n        if \"__gt__\" not in defined:\n            cls.__gt__ = lambda self, other: not (self < other or self == other)\n        if \"__le__\" not in defined:\n            cls.__le__ = lambda self, other: self < other or self == other\n        if \"__ge__\" not in defined:\n            cls.__ge__ = lambda self, other: not self < other\n    elif root == \"__le__\":\n        if \"__ge__\" not in defined:\n            cls.__ge__ = lambda self, other: not self <= other or self == other\n        if \"__lt__\" not in defined:\n            cls.__lt__ = lambda self, other: self <= other and not self == other\n        if \"__gt__\" not in defined:\n            cls.__gt__ = lambda self, other: not self <= other\n    elif root == \"__gt__\":\n        if \"__lt__\" not in defined:\n            cls.__lt__ = lambda self, other: not (self > other or self == other)\n        if \"__ge__\" not in defined:\n            cls.__ge__ = lambda self, other: self > other or self == other\n        if \"__le__\" not in defined:\n            cls.__le__ = lambda self, other: not self > other\n    else:\n        if \"__le__\" not in defined:\n            cls.__le__ = lambda self, other: not self >= other or self == other\n        if \"__gt__\" not in defined:\n            cls.__gt__ = lambda self, other: self >= other and not self == other\n        if \"__lt__\" not in defined:\n            cls.__lt__ = lambda self, other: not self >= other\n    return cls\n",
    ].joined()
}

fn bundled_heapq() -> String {
    [
        "# heapq: a list kept as a heap, whose smallest item is always first.\n#\n# Author: Alexius Academia\n# Date: 2026-10-08\n\n\ndef heappush(heap, item):\n    \"\"\"Adds an item to the heap.\"\"\"\n    heap.append(item)\n    _siftdown(heap, 0, len(heap) - 1)\n\n\ndef heappop(heap):\n    \"\"\"Takes the smallest item off the heap.\"\"\"\n    if not heap:\n        raise IndexError(\"index out of range\")\n    last = heap.pop()\n    if heap:\n        smallest = heap[0]\n        heap[0] = last\n        _siftup(heap, 0)\n        return smallest\n    return last\n\n\ndef heapreplace(heap, item):\n    \"\"\"Takes the smallest item off, and puts `item` on.\"\"\"\n    if not heap:\n        raise IndexError(\"index out of range\")\n    smallest = heap[0]\n    heap[0] = item\n    _siftup(heap, 0)\n    return smallest\n\n\ndef heappushpop(heap, item):\n    \"\"\"Puts `item` on, then takes the smallest item off.\"\"\"\n    if heap and heap[0] < item:\n        smallest = heap[0]\n        heap[0] = item\n",
        "        _siftup(heap, 0)\n        return smallest\n    return item\n\n\ndef heapify(x):\n    \"\"\"Makes a list a heap, in place.\"\"\"\n    n = len(x)\n    for i in reversed(range(n // 2)):\n        _siftup(x, i)\n\n\ndef _siftdown(heap, startpos, pos):\n    newitem = heap[pos]\n    while pos > startpos:\n        parentpos = (pos - 1) >> 1\n        parent = heap[parentpos]\n        if newitem < parent:\n            heap[pos] = parent\n            pos = parentpos\n            continue\n        break\n    heap[pos] = newitem\n\n\ndef _siftup(heap, pos):\n    endpos = len(heap)\n    startpos = pos\n    newitem = heap[pos]\n    childpos = 2 * pos + 1\n    while childpos < endpos:\n        rightpos = childpos + 1\n        if rightpos < endpos and not heap[childpos] < heap[rightpos]:\n            childpos = rightpos\n        heap[pos] = heap[childpos]\n        pos = childpos\n        childpos = 2 * pos + 1\n    heap[pos] = newitem\n    _siftdown(heap, startpos, pos)\n\n",
        "\ndef merge(*iterables, **kwargs):\n    \"\"\"Several sorted iterables as one sorted iterator.\"\"\"\n    key = kwargs.pop(\"key\", None)\n    reverse = kwargs.pop(\"reverse\", False)\n    if kwargs:\n        raise TypeError(\"merge() got an unexpected keyword argument\")\n    # (sorted() keeps the order of equal items, as merge does.)\n    items = []\n    for it in iterables:\n        for element in it:\n            items.append(element)\n    return iter(sorted(items, key=key, reverse=reverse))\n\n\ndef nsmallest(n, iterable, key=None):\n    \"\"\"The n smallest items, smallest first.\"\"\"\n    if n <= 0:\n        return []\n    return sorted(iterable, key=key)[:n]\n\n\ndef nlargest(n, iterable, key=None):\n    \"\"\"The n largest items, largest first.\"\"\"\n    if n <= 0:\n        return []\n    return sorted(iterable, key=key, reverse=True)[:n]\n",
    ].joined()
}

fn bundled_itertools() -> String {
    [
        "# itertools: functions that make and combine iterators.\n#\n# Author: Alexius Academia\n# Date: 2026-10-08\n#\n# Written as generators, the way Python's documentation shows what each\n# one is \"roughly equivalent to\". The ones that never end (count, cycle,\n# repeat with no times) need generators that run a step at a time.\n#\n# A function that checks its arguments does it before making its\n# generator, so that a wrong call fails where it's made.\n\n\ndef count(start=0, step=1):\n    \"\"\"start, start + step, start + 2 * step, … without end.\"\"\"\n    n = start\n    while True:\n        yield n\n        n += step\n\n\ndef cycle(iterable):\n    \"\"\"The items again and again, without end.\"\"\"\n    saved = []\n    for element in iterable:\n        yield element\n        saved.append(element)\n    while saved:\n        for element in saved:\n            yield element\n\n\ndef repeat(object, times=None):\n    \"\"\"The same object, `times` times (or without end).\"\"\"\n    if times is None:\n        while True:\n            yield object\n    else:\n        for i in range(times):\n            yield object\n",
        "\n\ndef accumulate(iterable, func=None, initial=None):\n    \"\"\"Running totals (or running results of `func`).\"\"\"\n    it = iter(iterable)\n    total = initial\n    if initial is None:\n        try:\n            total = next(it)\n        except StopIteration:\n            return\n    yield total\n    for element in it:\n        if func is None:\n            total = total + element\n        else:\n            total = func(total, element)\n        yield total\n\n\ndef chain(*iterables):\n    \"\"\"The items of the first iterable, then of the second, …\"\"\"\n    for it in iterables:\n        for element in it:\n            yield element\n\n\ndef _chain_from_iterable(iterables):\n    for it in iterables:\n        for element in it:\n            yield element\n\n\nchain.from_iterable = _chain_from_iterable\n\n\ndef compress(data, selectors):\n    \"\"\"The items of data whose selector is true.\"\"\"\n    for d, s in zip(data, selectors):\n        if s:\n",
        "            yield d\n\n\ndef dropwhile(predicate, iterable):\n    \"\"\"The items from the first one the predicate is false for.\"\"\"\n    dropping = True\n    for x in iterable:\n        if dropping and predicate(x):\n            continue\n        dropping = False\n        yield x\n\n\ndef takewhile(predicate, iterable):\n    \"\"\"The items before the first one the predicate is false for.\"\"\"\n    for x in iterable:\n        if predicate(x):\n            yield x\n        else:\n            break\n\n\ndef filterfalse(predicate, iterable):\n    \"\"\"The items the predicate is false for.\"\"\"\n    for x in iterable:\n        if predicate is None:\n            if not x:\n                yield x\n        elif not predicate(x):\n            yield x\n\n\ndef groupby(iterable, key=None):\n    \"\"\"(key, group) for each run of items that have the same key.\"\"\"\n    started = False\n    current = None\n    group = []\n    for element in iterable:\n        k = element if key is None else key(element)\n        if not started:\n",
        "            started = True\n            current = k\n        elif k != current:\n            yield (current, iter(group))\n            current = k\n            group = []\n        group.append(element)\n    if started:\n        yield (current, iter(group))\n\n\ndef _islice(iterable, start, stop, step):\n    wanted = start\n    i = 0\n    for element in iterable:\n        if i == wanted:\n            yield element\n            wanted += step\n            if stop is not None and wanted >= stop:\n                return\n        i += 1\n\n\ndef _is_index(value):\n    return isinstance(value, int) and value >= 0\n\n\ndef islice(iterable, *args):\n    \"\"\"islice(it, stop) or islice(it, start, stop[, step]): a slice of an iterator.\"\"\"\n    if len(args) == 0:\n        raise TypeError(\"islice expected at least 2 arguments, got 1\")\n    if len(args) > 3:\n        raise TypeError(\"islice expected at most 4 arguments, got %d\" % (len(args) + 1))\n    start = 0\n    step = 1\n    if len(args) == 1:\n        stop = args[0]\n        if stop is not None and not _is_index(stop):\n            raise ValueError(\"Stop argument for islice() must be None or an integer: 0 <= x <= sys.maxsize.\")\n    else:\n",
        "        start = 0 if args[0] is None else args[0]\n        stop = args[1]\n        if not _is_index(start):\n            raise ValueError(\"Indices for islice() must be None or an integer: 0 <= x <= sys.maxsize.\")\n        if stop is not None and not _is_index(stop):\n            raise ValueError(\"Stop argument for islice() must be None or an integer: 0 <= x <= sys.maxsize.\")\n        if len(args) == 3 and args[2] is not None:\n            step = args[2]\n            if not isinstance(step, int) or step < 1:\n                raise ValueError(\"Step for islice() must be a positive integer or None.\")\n    if stop is not None and stop <= start:\n        return iter(())\n    return _islice(iterable, start, stop, step)\n\n\ndef pairwise(iterable):\n    \"\"\"(first, second), (second, third), …\"\"\"\n    started = False\n    a = None\n    for b in iterable:\n        if started:\n            yield (a, b)\n        started = True\n        a = b\n\n\ndef starmap(function, iterable):\n    \"\"\"function(*args) for each args of the iterable.\"\"\"\n    for args in iterable:\n        yield function(*args)\n\n\ndef _zip_longest(iterators, fillvalue):\n    active = len(iterators)\n    if not active:\n        return\n    done = [False] * active\n    while True:\n        values = []\n        for i in range(len(iterators)):\n",
        "            value = fillvalue\n            if not done[i]:\n                try:\n                    value = next(iterators[i])\n                except StopIteration:\n                    done[i] = True\n                    active -= 1\n                    if not active:\n                        return\n                    value = fillvalue\n            values.append(value)\n        yield tuple(values)\n\n\ndef zip_longest(*iterables, **kwargs):\n    \"\"\"Like zip, to the end of the longest one: fillvalue where one ran out.\"\"\"\n    fillvalue = kwargs.pop(\"fillvalue\", None)\n    if kwargs:\n        raise TypeError(\"zip_longest() got an unexpected keyword argument\")\n    return _zip_longest([iter(it) for it in iterables], fillvalue)\n\n\ndef _product(pools):\n    result = [[]]\n    for pool in pools:\n        result = [x + [y] for x in result for y in pool]\n    for prod in result:\n        yield tuple(prod)\n\n\ndef product(*iterables, **kwargs):\n    \"\"\"Every way to take one item from each iterable.\"\"\"\n    repeat = kwargs.pop(\"repeat\", 1)\n    if kwargs:\n        raise TypeError(\"product() got an unexpected keyword argument\")\n    if not isinstance(repeat, int):\n        raise TypeError(\"'%s' object cannot be interpreted as an integer\" % type(repeat).__name__)\n    if repeat < 0:\n        raise ValueError(\"repeat argument cannot be negative\")\n    return _product([tuple(pool) for pool in iterables] * repeat)\n",
        "\n\ndef _permutations(pool, r):\n    n = len(pool)\n    if r > n:\n        return\n    indices = list(range(n))\n    cycles = list(range(n, n - r, -1))\n    yield tuple([pool[k] for k in indices[:r]])\n    while n:\n        found = False\n        for i in reversed(range(r)):\n            cycles[i] -= 1\n            if cycles[i] == 0:\n                indices[i:] = indices[i + 1:] + indices[i:i + 1]\n                cycles[i] = n - i\n            else:\n                j = cycles[i]\n                indices[i], indices[-j] = indices[-j], indices[i]\n                yield tuple([pool[k] for k in indices[:r]])\n                found = True\n                break\n        if not found:\n            return\n\n\ndef permutations(iterable, r=None):\n    \"\"\"Every way to put r of the items in order.\"\"\"\n    pool = tuple(iterable)\n    if r is None:\n        r = len(pool)\n    if not isinstance(r, int):\n        raise TypeError(\"Expected int as r\")\n    if r < 0:\n        raise ValueError(\"r must be non-negative\")\n    return _permutations(pool, r)\n\n\ndef _combinations(pool, r):\n    n = len(pool)\n",
        "    if r > n:\n        return\n    indices = list(range(r))\n    yield tuple([pool[k] for k in indices])\n    while True:\n        found = False\n        for i in reversed(range(r)):\n            if indices[i] != i + n - r:\n                found = True\n                break\n        if not found:\n            return\n        indices[i] += 1\n        for j in range(i + 1, r):\n            indices[j] = indices[j - 1] + 1\n        yield tuple([pool[k] for k in indices])\n\n\ndef combinations(iterable, r):\n    \"\"\"Every way to choose r of the items, in the order they come.\"\"\"\n    pool = tuple(iterable)\n    if not isinstance(r, int):\n        raise TypeError(\"'%s' object cannot be interpreted as an integer\" % type(r).__name__)\n    if r < 0:\n        raise ValueError(\"r must be non-negative\")\n    return _combinations(pool, r)\n\n\ndef _combinations_with_replacement(pool, r):\n    n = len(pool)\n    if not n and r:\n        return\n    indices = [0] * r\n    yield tuple([pool[k] for k in indices])\n    while True:\n        found = False\n        for i in reversed(range(r)):\n            if indices[i] != n - 1:\n                found = True\n                break\n",
        "        if not found:\n            return\n        indices[i:] = [indices[i] + 1] * (r - i)\n        yield tuple([pool[k] for k in indices])\n\n\ndef combinations_with_replacement(iterable, r):\n    \"\"\"Every way to choose r of the items, where an item may be chosen again.\"\"\"\n    pool = tuple(iterable)\n    if not isinstance(r, int):\n        raise TypeError(\"'%s' object cannot be interpreted as an integer\" % type(r).__name__)\n    if r < 0:\n        raise ValueError(\"r must be non-negative\")\n    return _combinations_with_replacement(pool, r)\n\n\ndef _batched(iterable, n):\n    batch = []\n    for element in iterable:\n        batch.append(element)\n        if len(batch) == n:\n            yield tuple(batch)\n            batch = []\n    if batch:\n        yield tuple(batch)\n\n\ndef batched(iterable, n):\n    \"\"\"The items in tuples of n (the last one may be shorter).\"\"\"\n    if n < 1:\n        raise ValueError(\"n must be at least one\")\n    return _batched(iterable, n)\n\n\ndef _tee_one(it, mine, buffers):\n    while True:\n        if not mine:\n            try:\n                value = next(it)\n            except StopIteration:\n",
        "                return\n            for buffer in buffers:\n                buffer.append(value)\n        yield mine.pop(0)\n\n\ndef tee(iterable, n=2):\n    \"\"\"n iterators that each give the iterable's items.\"\"\"\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n    it = iter(iterable)\n    buffers = [[] for i in range(n)]\n    return tuple([_tee_one(it, mine, buffers) for mine in buffers])\n",
    ].joined()
}

fn bundled_operator() -> String {
    [
        "# operator: Python's operators as functions, and makers of small functions.\n#\n# Author: Alexius Academia\n# Date: 2026-10-08\n\n# (The built-in abs, before this module's own takes the name.)\n_abs = abs\n\n\ndef lt(a, b):\n    return a < b\n\n\ndef le(a, b):\n    return a <= b\n\n\ndef eq(a, b):\n    return a == b\n\n\ndef ne(a, b):\n    return a != b\n\n\ndef ge(a, b):\n    return a >= b\n\n\ndef gt(a, b):\n    return a > b\n\n\ndef not_(a):\n    return not a\n\n\ndef truth(a):\n    return True if a else False\n\n",
        "\ndef is_(a, b):\n    return a is b\n\n\ndef is_not(a, b):\n    return a is not b\n\n\ndef abs(a):\n    return _abs(a)\n\n\ndef add(a, b):\n    return a + b\n\n\ndef and_(a, b):\n    return a & b\n\n\ndef floordiv(a, b):\n    return a // b\n\n\ndef index(a):\n    if not isinstance(a, int):\n        raise TypeError(\"'%s' object cannot be interpreted as an integer\" % type(a).__name__)\n    return a\n\n\ndef inv(a):\n    return ~a\n\n\ninvert = inv\n\n\ndef lshift(a, b):\n    return a << b\n",
        "\n\ndef mod(a, b):\n    return a % b\n\n\ndef mul(a, b):\n    return a * b\n\n\ndef neg(a):\n    return -a\n\n\ndef or_(a, b):\n    return a | b\n\n\ndef pos(a):\n    return +a\n\n\ndef pow(a, b):\n    return a ** b\n\n\ndef rshift(a, b):\n    return a >> b\n\n\ndef sub(a, b):\n    return a - b\n\n\ndef truediv(a, b):\n    return a / b\n\n\ndef xor(a, b):\n    return a ^ b\n",
        "\n\ndef concat(a, b):\n    if not hasattr(a, \"__getitem__\") and not isinstance(a, (str, list, tuple)):\n        raise TypeError(\"'%s' object can't be concatenated\" % type(a).__name__)\n    return a + b\n\n\ndef contains(a, b):\n    return b in a\n\n\ndef countOf(a, b):\n    count = 0\n    for item in a:\n        if item is b or item == b:\n            count += 1\n    return count\n\n\ndef delitem(a, b):\n    del a[b]\n\n\ndef getitem(a, b):\n    return a[b]\n\n\ndef indexOf(a, b):\n    i = 0\n    for item in a:\n        if item is b or item == b:\n            return i\n        i += 1\n    raise ValueError(\"sequence.index(x): x not in sequence\")\n\n\ndef setitem(a, b, c):\n    a[b] = c\n\n",
        "\ndef length_hint(obj, default=0):\n    try:\n        return len(obj)\n    except TypeError:\n        return default\n\n\nclass attrgetter:\n    \"\"\"attrgetter(\"a.b\")(x) is x.a.b; with several names, a tuple of them.\"\"\"\n\n    __module__ = \"operator\"\n\n    def __init__(self, attr, *attrs):\n        names = (attr,) + attrs\n        for name in names:\n            if not isinstance(name, str):\n                raise TypeError(\"attribute name must be a string\")\n        self._attrs = names\n\n    def _resolve(self, obj, name):\n        for part in name.split(\".\"):\n            obj = getattr(obj, part)\n        return obj\n\n    def __call__(self, obj):\n        if len(self._attrs) == 1:\n            return self._resolve(obj, self._attrs[0])\n        return tuple([self._resolve(obj, name) for name in self._attrs])\n\n    def __repr__(self):\n        return \"operator.attrgetter(%s)\" % \", \".join([repr(a) for a in self._attrs])\n\n\nclass itemgetter:\n    \"\"\"itemgetter(1)(x) is x[1]; with several items, a tuple of them.\"\"\"\n\n    __module__ = \"operator\"\n\n    def __init__(self, item, *items):\n",
        "        self._items = (item,) + items\n\n    def __call__(self, obj):\n        if len(self._items) == 1:\n            return obj[self._items[0]]\n        return tuple([obj[item] for item in self._items])\n\n    def __repr__(self):\n        return \"operator.itemgetter(%s)\" % \", \".join([repr(i) for i in self._items])\n\n\nclass methodcaller:\n    \"\"\"methodcaller(\"name\", 1)(x) is x.name(1).\"\"\"\n\n    __module__ = \"operator\"\n\n    def __init__(self, name, *args, **kwargs):\n        if not isinstance(name, str):\n            raise TypeError(\"method name must be a string\")\n        self._name = name\n        self._args = args\n        self._kwargs = kwargs\n\n    def __call__(self, obj):\n        return getattr(obj, self._name)(*self._args, **self._kwargs)\n\n    def __repr__(self):\n        parts = [repr(self._name)]\n        for a in self._args:\n            parts.append(repr(a))\n        for k in self._kwargs:\n            parts.append(\"%s=%r\" % (k, self._kwargs[k]))\n        return \"operator.methodcaller(%s)\" % \", \".join(parts)\n\n\ndef iadd(a, b):\n    a += b\n    return a\n\n\n",
        "def iand(a, b):\n    a &= b\n    return a\n\n\ndef iconcat(a, b):\n    a += b\n    return a\n\n\ndef ifloordiv(a, b):\n    a //= b\n    return a\n\n\ndef ilshift(a, b):\n    a <<= b\n    return a\n\n\ndef imod(a, b):\n    a %= b\n    return a\n\n\ndef imul(a, b):\n    a *= b\n    return a\n\n\ndef ior(a, b):\n    a |= b\n    return a\n\n\ndef ipow(a, b):\n    a **= b\n    return a\n\n\n",
        "def irshift(a, b):\n    a >>= b\n    return a\n\n\ndef isub(a, b):\n    a -= b\n    return a\n\n\ndef itruediv(a, b):\n    a /= b\n    return a\n\n\ndef ixor(a, b):\n    a ^= b\n    return a\n\n\n__lt__ = lt\n__le__ = le\n__eq__ = eq\n__ne__ = ne\n__ge__ = ge\n__gt__ = gt\n__add__ = add\n__sub__ = sub\n__mul__ = mul\n__truediv__ = truediv\n__floordiv__ = floordiv\n__mod__ = mod\n__neg__ = neg\n__not__ = not_\n__getitem__ = getitem\n__contains__ = contains\n",
    ].joined()
}

fn bundled_re() -> String {
    [
        "# re: regular expressions.\n#\n# Author: Alexius Academia\n# Date: 2026-10-08\n#\n# The engine is PyTessel's own (regex.tsl), reached through the built-in\n# module _re: compile() gives a pattern's number, match() one match and\n# scan() every match of a text, each as a list of where the groups start\n# and end. Pattern and Match are made on those here.\nimport _re\n\nA = ASCII = 256\nI = IGNORECASE = 2\nL = LOCALE = 4\nM = MULTILINE = 8\nS = DOTALL = 16\nU = UNICODE = 32\nX = VERBOSE = 64\n\n_FLAG_NAMES = [(256, \"re.ASCII\"), (2, \"re.IGNORECASE\"), (4, \"re.LOCALE\"), (8, \"re.MULTILINE\"),\n               (16, \"re.DOTALL\"), (64, \"re.VERBOSE\")]\n\n\nclass error(Exception):\n    \"\"\"A pattern that isn't a valid regular expression.\"\"\"\n\n    __module__ = \"re\"\n\n    def __init__(self, msg, pattern=None, pos=None):\n        self.msg = msg\n        self.pattern = pattern\n        self.pos = pos\n        self.lineno = None\n        self.colno = None\n        if pattern is not None and pos is not None:\n            msg = \"%s at position %d\" % (msg, pos)\n            before = pattern[:pos]\n            self.lineno = before.count(\"\\n\") + 1\n            self.colno = pos - before.rfind(\"\\n\")\n            if \"\\n\" in pattern:\n",
        "                msg = \"%s (line %d, column %d)\" % (msg, self.lineno, self.colno)\n        super().__init__(msg)\n\n\ndef _is_text(value):\n    return isinstance(value, str)\n\n\nclass Match:\n    \"\"\"One match of a pattern in a text.\"\"\"\n\n    __module__ = \"re\"\n\n    def __init__(self, pattern, string, pos, endpos, spans):\n        self.re = pattern\n        self.string = string\n        self.pos = pos\n        self.endpos = endpos\n        self._spans = spans\n        last = spans[len(spans) - 1]\n        self.lastindex = last if last > 0 else None\n        self.lastgroup = pattern._names.get(last)\n\n    def _index(self, group):\n        if isinstance(group, int):\n            if 0 <= group <= self.re.groups:\n                return group\n        elif isinstance(group, str):\n            if group in self.re.groupindex:\n                return self.re.groupindex[group]\n        raise IndexError(\"no such group\")\n\n    def _text(self, index, default=None):\n        start = self._spans[2 * index]\n        if start < 0:\n            return default\n        return _re.text(self.string, start, self._spans[2 * index + 1])\n\n    def group(self, *groups):\n        if len(groups) == 0:\n",
        "            return self._text(0)\n        if len(groups) == 1:\n            return self._text(self._index(groups[0]))\n        return tuple([self._text(self._index(g)) for g in groups])\n\n    def __getitem__(self, group):\n        return self._text(self._index(group))\n\n    def groups(self, default=None):\n        return tuple([self._text(i, default) for i in range(1, self.re.groups + 1)])\n\n    def groupdict(self, default=None):\n        out = \{\}\n        for name in self.re.groupindex:\n            out[name] = self._text(self.re.groupindex[name], default)\n        return out\n\n    def start(self, group=0):\n        return self._spans[2 * self._index(group)]\n\n    def end(self, group=0):\n        return self._spans[2 * self._index(group) + 1]\n\n    def span(self, group=0):\n        index = self._index(group)\n        return (self._spans[2 * index], self._spans[2 * index + 1])\n\n    def expand(self, template):\n        return _expand(_template(self.re, template), self.string, self._spans)\n\n    def __bool__(self):\n        return True\n\n    def __repr__(self):\n        return \"<re.Match object; span=%r, match=%r>\" % (self.span(), self.group())\n\n\nclass Pattern:\n    \"\"\"A compiled regular expression.\"\"\"\n\n",
        "    __module__ = \"re\"\n\n    def __init__(self, pattern, flags, code, groups, groupindex):\n        self.pattern = pattern\n        self.flags = flags\n        self.groups = groups\n        self.groupindex = groupindex\n        self._code = code\n        self._names = \{\}\n        for name in groupindex:\n            self._names[groupindex[name]] = name\n\n    def __repr__(self):\n        text = repr(self.pattern)\n        if len(text) > 200:\n            text = text[:200]\n        names = [name for bit, name in _FLAG_NAMES if self.flags & bit]\n        if names:\n            return \"re.compile(%s, %s)\" % (text, \"|\".join(names))\n        return \"re.compile(%s)\" % text\n\n    def __eq__(self, other):\n        return isinstance(other, Pattern) and self.pattern == other.pattern and self.flags == other.flags\n\n    def __hash__(self):\n        return hash((self.pattern, self.flags))\n\n    def _range(self, string, pos, endpos):\n        if not _is_text(string):\n            raise TypeError(\"expected string or bytes-like object\")\n        size = len(string)\n        if endpos is None or endpos > size:\n            endpos = size\n        if endpos < 0:\n            endpos = 0\n        if pos < 0:\n            pos = 0\n        if pos > size:\n            pos = size\n        return pos, endpos\n",
        "\n    def _one(self, string, pos, endpos, mode):\n        pos, endpos = self._range(string, pos, endpos)\n        spans = _re.match(self._code, string, pos, endpos, mode)\n        if spans is None:\n            return None\n        return Match(self, string, pos, endpos, spans)\n\n    def match(self, string, pos=0, endpos=None):\n        return self._one(string, pos, endpos, 0)\n\n    def fullmatch(self, string, pos=0, endpos=None):\n        return self._one(string, pos, endpos, 1)\n\n    def search(self, string, pos=0, endpos=None):\n        return self._one(string, pos, endpos, 2)\n\n    def finditer(self, string, pos=0, endpos=None):\n        pos, endpos = self._range(string, pos, endpos)\n        found = _re.scan(self._code, string, pos, endpos, 0)\n        return iter([Match(self, string, pos, endpos, spans) for spans in found])\n\n    def findall(self, string, pos=0, endpos=None):\n        pos, endpos = self._range(string, pos, endpos)\n        groups = self.groups\n        # Where every wanted part starts and ends, then all of them at once.\n        bounds = []\n        for spans in _re.scan(self._code, string, pos, endpos, 0):\n            if groups == 0:\n                bounds.append(spans[0])\n                bounds.append(spans[1])\n            else:\n                for i in range(2, 2 * groups + 2):\n                    bounds.append(spans[i])\n        parts = _re.cut(string, bounds)\n        if groups <= 1:\n            return [part if part is not None else \"\" for part in parts]\n        out = []\n        for i in range(0, len(parts), groups):\n            out.append(tuple([part if part is not None else \"\" for part in parts[i:i + groups]]))\n",
        "        return out\n\n    def split(self, string, maxsplit=0):\n        pos, endpos = self._range(string, 0, None)\n        if maxsplit < 0:\n            return [string]\n        bounds = []\n        last = 0\n        for spans in _re.scan(self._code, string, 0, endpos, maxsplit):\n            bounds.append(last)\n            bounds.append(spans[0])\n            for i in range(2, 2 * self.groups + 2):\n                bounds.append(spans[i])\n            last = spans[1]\n        bounds.append(last)\n        bounds.append(endpos)\n        return _re.cut(string, bounds)\n\n    def subn(self, repl, string, count=0):\n        pos, endpos = self._range(string, 0, None)\n        function = None\n        parts = None\n        if callable(repl):\n            function = repl\n        else:\n            if not _is_text(repl):\n                raise TypeError(\"expected str instance, %s found\" % type(repl).__name__)\n            parts = _template(self, repl)\n            if len(parts) == 1 and _is_text(parts[0]):\n                # (Nothing of the match in it: the same text each time.)\n                repl = parts[0]\n                parts = None\n            elif len(parts) == 0:\n                repl = \"\"\n                parts = None\n        if count < 0:\n            return string, 0\n        found = _re.scan(self._code, string, 0, endpos, count)\n        # What's between the matches, all at once.\n        bounds = []\n",
        "        last = 0\n        for spans in found:\n            bounds.append(last)\n            bounds.append(spans[0])\n            last = spans[1]\n        bounds.append(last)\n        bounds.append(endpos)\n        between = _re.cut(string, bounds)\n        pieces = []\n        done = 0\n        for spans in found:\n            pieces.append(between[done])\n            if function is not None:\n                pieces.append(function(Match(self, string, 0, endpos, spans)))\n            elif parts is not None:\n                pieces.append(_expand(parts, string, spans))\n            else:\n                pieces.append(repl)\n            done += 1\n        pieces.append(between[done])\n        return \"\".join(pieces), done\n\n    def sub(self, repl, string, count=0):\n        return self.subn(repl, string, count)[0]\n\n\n# ---- what replaces a match: \"\\1-\\g<name>\" ----\n\n_ESCAPES = \{\"n\": \"\\n\", \"t\": \"\\t\", \"r\": \"\\r\", \"f\": \"\\f\", \"v\": \"\\v\", \"a\": \"\\a\", \"b\": \"\\b\", \"\\\\\": \"\\\\\"\}\n_ASCII_LETTERS = \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n_DIGITS = \"0123456789\"\n_OCTAL = \"01234567\"\n\n\ndef _template(pattern, repl):\n    \"\"\"A replacement text as a list of its parts: texts, and groups' numbers.\"\"\"\n    if \"\\\\\" not in repl:\n        return [repl] if repl else []\n    parts = []\n    text = []\n",
        "    size = len(repl)\n    i = 0\n    while i < size:\n        c = repl[i]\n        if c != \"\\\\\":\n            text.append(c)\n            i += 1\n            continue\n        at = i\n        i += 1\n        if i >= size:\n            raise error(\"bad escape (end of pattern)\", repl, at)\n        c = repl[i]\n        i += 1\n        group = -1\n        if c == \"g\":\n            if i >= size or repl[i] != \"<\":\n                raise error(\"missing <\", repl, i)\n            i += 1\n            start = i\n            end = repl.find(\">\", i)\n            if end < 0:\n                if i >= size:\n                    raise error(\"missing group name\", repl, start)\n                raise error(\"missing >, unterminated name\", repl, start)\n            name = repl[i:end]\n            i = end + 1\n            if name == \"\":\n                raise error(\"missing group name\", repl, start)\n            if name.isdigit():\n                group = int(name)\n                if group > pattern.groups:\n                    raise error(\"invalid group reference %d\" % group, repl, start)\n            else:\n                if not name.isidentifier():\n                    raise error(\"bad character in group name %r\" % name, repl, start)\n                if name not in pattern.groupindex:\n                    raise IndexError(\"unknown group name %r\" % name)\n                group = pattern.groupindex[name]\n        elif c == \"0\":\n",
        "            # \\0, \\012: a character by its number in base 8.\n            value = 0\n            used = 0\n            while used < 2 and i < size and repl[i] in _OCTAL:\n                value = value * 8 + int(repl[i])\n                i += 1\n                used += 1\n            text.append(chr(value))\n        elif c in _DIGITS:\n            group = int(c)\n            if i < size and repl[i] in _DIGITS:\n                if c in _OCTAL and repl[i] in _OCTAL and i + 1 < size and repl[i + 1] in _OCTAL:\n                    value = int(c) * 64 + int(repl[i]) * 8 + int(repl[i + 1])\n                    i += 2\n                    if value > 255:\n                        raise error(\"octal escape value %s outside of range 0-0o377\" % repl[at:i], repl, at)\n                    text.append(chr(value))\n                    group = -1\n                else:\n                    group = group * 10 + int(repl[i])\n                    i += 1\n            if group > pattern.groups:\n                raise error(\"invalid group reference %d\" % group, repl, at + 1)\n        elif c in _ESCAPES:\n            text.append(_ESCAPES[c])\n        elif c in _ASCII_LETTERS:\n            raise error(\"bad escape \\\\%s\" % c, repl, at)\n        else:\n            text.append(\"\\\\\" + c)\n        if group >= 0:\n            if text:\n                parts.append(\"\".join(text))\n                text = []\n            parts.append(group)\n    if text:\n        parts.append(\"\".join(text))\n    return parts\n\n\ndef _expand(parts, string, spans):\n",
        "    out = []\n    for part in parts:\n        if isinstance(part, int):\n            start = spans[2 * part]\n            if start >= 0:\n                out.append(_re.text(string, start, spans[2 * part + 1]))\n        else:\n            out.append(part)\n    return \"\".join(out)\n\n\n# ---- the module's functions ----\n\n_cache = \{\}\n\n\ndef compile(pattern, flags=0):\n    if isinstance(pattern, Pattern):\n        if flags:\n            raise ValueError(\"cannot process flags argument with a compiled pattern\")\n        return pattern\n    if not _is_text(pattern):\n        raise TypeError(\"first argument must be string or compiled pattern\")\n    key = (pattern, flags)\n    if key in _cache:\n        return _cache[key]\n    made = _re.compile(pattern, flags)\n    if len(made) == 2:\n        if made[1] < 0:\n            raise error(made[0])\n        raise error(made[0], pattern, made[1])\n    code, groups, names, numbers, flags = made\n    if not flags & 256:\n        flags = flags | 32\n    groupindex = \{\}\n    for i in range(len(names)):\n        groupindex[names[i]] = numbers[i]\n    compiled = Pattern(pattern, flags, code, groups, groupindex)\n    if len(_cache) >= 512:\n        _cache.clear()\n",
        "    _cache[key] = compiled\n    return compiled\n\n\ndef purge():\n    _cache.clear()\n\n\ndef match(pattern, string, flags=0):\n    return compile(pattern, flags).match(string)\n\n\ndef fullmatch(pattern, string, flags=0):\n    return compile(pattern, flags).fullmatch(string)\n\n\ndef search(pattern, string, flags=0):\n    return compile(pattern, flags).search(string)\n\n\ndef sub(pattern, repl, string, count=0, flags=0):\n    return compile(pattern, flags).sub(repl, string, count)\n\n\ndef subn(pattern, repl, string, count=0, flags=0):\n    return compile(pattern, flags).subn(repl, string, count)\n\n\ndef split(pattern, string, maxsplit=0, flags=0):\n    return compile(pattern, flags).split(string, maxsplit)\n\n\ndef findall(pattern, string, flags=0):\n    return compile(pattern, flags).findall(string)\n\n\ndef finditer(pattern, string, flags=0):\n    return compile(pattern, flags).finditer(string)\n\n\n",
        "_SPECIAL = \"()[]\{\}?*+-|^$\\\\.&~# \\t\\n\\r\\v\\f\"\n\n\ndef escape(pattern):\n    \"\"\"The text as a pattern that matches exactly it.\"\"\"\n    out = []\n    for c in pattern:\n        if c in _SPECIAL:\n            out.append(\"\\\\\" + c)\n        else:\n            out.append(c)\n    return \"\".join(out)\n",
    ].joined()
}

fn bundled_statistics() -> String {
    [
        "# statistics: averages and measures of spread.\n#\n# Author: Alexius Academia\n# Date: 2026-10-08\n#\n# Python works these out with exact fractions. PyTessel has none: whole\n# numbers are added exactly as they are, and floats with math.fsum, which\n# gives the sum as if nothing were lost on the way; a division is then\n# corrected by what it left over (see _divide). The results are Python's,\n# but for a rare last digit.\nimport math\n\n\nclass StatisticsError(ValueError):\n    __module__ = \"statistics\"\n\n\ndef _numbers(data):\n    # The data as a list, checked. Gives (values, whether all are ints).\n    values = list(data)\n    whole = True\n    for x in values:\n        if isinstance(x, int):\n            continue\n        if isinstance(x, float):\n            whole = False\n            continue\n        raise TypeError(\"can't convert type '%s' to numerator/denominator\" % type(x).__name__)\n    return values, whole\n\n\ndef _ratio(total, n):\n    # total / n for whole numbers: a whole number when it divides evenly.\n    if total % n == 0:\n        return total // n\n    return total / n\n\n\ndef _split(a):\n    # A float as two halves that add up to it (each has half its digits).\n",
        "    c = 134217729.0 * a\n    high = c - (c - a)\n    return high, a - high\n\n\ndef _divide(terms, n):\n    # The sum of some floats divided by n, rounded once: the sum is taken\n    # as if nothing were lost, and what the division leaves over (worked\n    # out exactly, as Dekker's product does) corrects the quotient.\n    q = math.fsum(terms) / n\n    if q != q or abs(q) > 1.0e290:\n        # (Too large to take apart; or not a number at all.)\n        return q\n    d = float(n)\n    product = q * d\n    qh, ql = _split(q)\n    dh, dl = _split(d)\n    error = ((qh * dh - product) + qh * dl + ql * dh) + ql * dl\n    rest = math.fsum(list(terms) + [0.0 - product, 0.0 - error])\n    return q + rest / n\n\n\ndef mean(data):\n    \"\"\"The arithmetic mean: the sum divided by how many there are.\"\"\"\n    values, whole = _numbers(data)\n    n = len(values)\n    if n < 1:\n        raise StatisticsError(\"mean requires at least one data point\")\n    if whole:\n        return _ratio(sum(values), n)\n    return _divide(values, n)\n\n\ndef fmean(data):\n    \"\"\"The mean, as a float (faster than mean).\"\"\"\n    values = list(data)\n    n = len(values)\n    if n < 1:\n        raise StatisticsError(\"fmean requires at least one data point\")\n    return math.fsum(values) / n\n",
        "\n\ndef geometric_mean(data):\n    \"\"\"The n-th root of the product of n numbers.\"\"\"\n    values = list(data)\n    if not values:\n        raise StatisticsError(\"geometric mean requires a non-empty dataset containing positive numbers\")\n    logs = []\n    for x in values:\n        if x <= 0:\n            raise StatisticsError(\"geometric mean requires a non-empty dataset containing positive numbers\")\n        logs.append(math.log(x))\n    return math.exp(math.fsum(logs) / len(logs))\n\n\ndef median(data):\n    \"\"\"The middle value (the mean of the two middle ones, for an even count).\"\"\"\n    values = sorted(data)\n    n = len(values)\n    if n == 0:\n        raise StatisticsError(\"no median for empty data\")\n    if n % 2 == 1:\n        return values[n // 2]\n    i = n // 2\n    return (values[i - 1] + values[i]) / 2\n\n\ndef median_low(data):\n    \"\"\"The middle value; of the two middle ones, the smaller.\"\"\"\n    values = sorted(data)\n    n = len(values)\n    if n == 0:\n        raise StatisticsError(\"no median for empty data\")\n    if n % 2 == 1:\n        return values[n // 2]\n    return values[n // 2 - 1]\n\n\ndef median_high(data):\n    \"\"\"The middle value; of the two middle ones, the larger.\"\"\"\n",
        "    values = sorted(data)\n    n = len(values)\n    if n == 0:\n        raise StatisticsError(\"no median for empty data\")\n    return values[n // 2]\n\n\ndef _counts(data):\n    # How many times each value comes, in the order they first come.\n    counts = \{\}\n    for x in data:\n        counts[x] = counts.get(x, 0) + 1\n    return counts\n\n\ndef mode(data):\n    \"\"\"The value that comes most often (the first of them, if several do).\"\"\"\n    counts = _counts(data)\n    if not counts:\n        raise StatisticsError(\"no mode for empty data\")\n    best = None\n    most = 0\n    for value in counts:\n        if counts[value] > most:\n            best = value\n            most = counts[value]\n    return best\n\n\ndef multimode(data):\n    \"\"\"Every value that comes most often, in the order they first come.\"\"\"\n    counts = _counts(data)\n    if not counts:\n        return []\n    most = max(counts.values())\n    return [value for value in counts if counts[value] == most]\n\n\ndef _ss(values, whole, c):\n    # The sum of the squares of each value's distance from c (the mean,\n",
        "    # when c is None): a whole number where it's exact (with True), or\n    # the floats that add up to it (with False).\n    n = len(values)\n    if c is None:\n        c = mean(values)\n        if whole and isinstance(c, int):\n            return sum([(x - c) ** 2 for x in values]), True\n        squares = [(x - c) ** 2 for x in values]\n        # (The distances should add up to nothing; what they do add up to,\n        # from rounding, is taken off.)\n        off = math.fsum([x - c for x in values])\n        squares.append(0.0 - off * off / n)\n        return squares, False\n    if whole and isinstance(c, int):\n        return sum([(x - c) ** 2 for x in values]), True\n    return [float((x - c) ** 2) for x in values], False\n\n\ndef variance(data, xbar=None):\n    \"\"\"The sample variance: for data that's a sample of something larger.\"\"\"\n    values, whole = _numbers(data)\n    n = len(values)\n    if n < 2:\n        raise StatisticsError(\"variance requires at least two data points\")\n    total, exact = _ss(values, whole, xbar)\n    if exact:\n        return _ratio(total, n - 1)\n    return _divide(total, n - 1)\n\n\ndef pvariance(data, mu=None):\n    \"\"\"The population variance: for data that's the whole of something.\"\"\"\n    values, whole = _numbers(data)\n    n = len(values)\n    if n < 1:\n        raise StatisticsError(\"pvariance requires at least one data point\")\n    total, exact = _ss(values, whole, mu)\n    if exact:\n        return _ratio(total, n)\n    return _divide(total, n)\n",
        "\n\ndef stdev(data, xbar=None):\n    \"\"\"The sample standard deviation: the square root of the variance.\"\"\"\n    return math.sqrt(variance(data, xbar))\n\n\ndef pstdev(data, mu=None):\n    \"\"\"The population standard deviation.\"\"\"\n    return math.sqrt(pvariance(data, mu))\n",
    ].joined()
}

fn bundled_textwrap() -> String {
    [
        "# textwrap: wrapping and filling paragraphs of text.\n#\n# Author: Alexius Academia\n# Date: 2026-10-08\n#\n# After CPython's textwrap: the text is cut into chunks (words, runs of\n# spaces, the parts of hyphenated words) with a regular expression, and\n# the chunks are put on lines.\nimport re\n\n_whitespace = \"\\t\\n\\x0b\\x0c\\r \"\n\n\ndef _expandtabs(text, tabsize):\n    # str.expandtabs: each tab becomes spaces up to the next tab stop.\n    if \"\\t\" not in text:\n        return text\n    out = []\n    column = 0\n    for c in text:\n        if c == \"\\t\":\n            if tabsize > 0:\n                n = tabsize - column % tabsize\n                out.append(\" \" * n)\n                column += n\n        elif c == \"\\n\" or c == \"\\r\":\n            out.append(c)\n            column = 0\n        else:\n            out.append(c)\n            column += 1\n    return \"\".join(out)\n\n\ndef _spaces_only(text):\n    # Every kind of white space becomes a plain space.\n    out = []\n    changed = False\n    for c in text:\n        if c in \"\\t\\n\\x0b\\x0c\\r\":\n",
        "            out.append(\" \")\n            changed = True\n        else:\n            out.append(c)\n    return \"\".join(out) if changed else text\n\n\ndef _lines_with_ends(text):\n    # str.splitlines(keepends=True).\n    lines = []\n    start = 0\n    i = 0\n    size = len(text)\n    while i < size:\n        c = text[i]\n        if c == \"\\r\" and i + 1 < size and text[i + 1] == \"\\n\":\n            i += 2\n            lines.append(text[start:i])\n            start = i\n        elif c in \"\\n\\r\\x0b\\x0c\\x1c\\x1d\\x1e\\x85  \":\n            i += 1\n            lines.append(text[start:i])\n            start = i\n        else:\n            i += 1\n    if start < size:\n        lines.append(text[start:])\n    return lines\n\n\n_word_punct = \"[\\\\w!\\\"'&.,?]\"\n_letter = \"[^\\\\d\\\\W]\"\n_ws = \"[\" + re.escape(_whitespace) + \"]\"\n_nws = \"[^\" + _ws[1:]\n\n_wordsep_re = re.compile((r\"\"\"\n    ( # any whitespace\n      WS+\n    | # em-dash between words\n      (?<=WP) -\{2,\} (?=\\w)\n",
        "    | # word, possibly hyphenated\n      NWS+? (?:\n        # hyphenated word\n          -(?: (?<=LT\{2\}-) | (?<=LT-LT-))\n          (?= LT -? LT)\n        | # end of word\n          (?=WS|\\Z)\n        | # em-dash\n          (?<=WP) (?=-\{2,\}\\w)\n        )\n    )\"\"\").replace(\"NWS\", _nws).replace(\"WS\", _ws).replace(\"WP\", _word_punct).replace(\"LT\", _letter), re.VERBOSE)\n\n_wordsep_simple_re = re.compile(\"(\" + _ws + \"+)\")\n\n_sentence_end_re = re.compile(r\"[a-z][\\.\\!\\?][\\\"\\']?\\Z\")\n\n\nclass TextWrapper:\n    \"\"\"Wraps text: wrap() gives the lines, fill() the lines as one text.\"\"\"\n\n    __module__ = \"textwrap\"\n\n    def __init__(self, width=70, initial_indent=\"\", subsequent_indent=\"\", expand_tabs=True,\n                 replace_whitespace=True, fix_sentence_endings=False, break_long_words=True,\n                 drop_whitespace=True, break_on_hyphens=True, tabsize=8, max_lines=None,\n                 placeholder=\" [...]\"):\n        self.width = width\n        self.initial_indent = initial_indent\n        self.subsequent_indent = subsequent_indent\n        self.expand_tabs = expand_tabs\n        self.replace_whitespace = replace_whitespace\n        self.fix_sentence_endings = fix_sentence_endings\n        self.break_long_words = break_long_words\n        self.drop_whitespace = drop_whitespace\n        self.break_on_hyphens = break_on_hyphens\n        self.tabsize = tabsize\n        self.max_lines = max_lines\n        self.placeholder = placeholder\n\n    def _munge_whitespace(self, text):\n",
        "        if self.expand_tabs:\n            text = _expandtabs(text, self.tabsize)\n        if self.replace_whitespace:\n            text = _spaces_only(text)\n        return text\n\n    def _split(self, text):\n        if self.break_on_hyphens is True:\n            chunks = _wordsep_re.split(text)\n        else:\n            chunks = _wordsep_simple_re.split(text)\n        return [c for c in chunks if c]\n\n    def _fix_sentence_endings(self, chunks):\n        i = 0\n        while i < len(chunks) - 1:\n            if chunks[i + 1] == \" \" and _sentence_end_re.search(chunks[i]):\n                chunks[i + 1] = \"  \"\n                i += 2\n            else:\n                i += 1\n\n    def _handle_long_word(self, reversed_chunks, cur_line, cur_len, width):\n        if width < 1:\n            space_left = 1\n        else:\n            space_left = width - cur_len\n        if self.break_long_words:\n            last = len(reversed_chunks) - 1\n            cur_line.append(reversed_chunks[last][:space_left])\n            reversed_chunks[last] = reversed_chunks[last][space_left:]\n        elif not cur_line:\n            cur_line.append(reversed_chunks.pop())\n\n    def _wrap_chunks(self, chunks):\n        lines = []\n        if self.width <= 0:\n            raise ValueError(\"invalid width %r (must be > 0)\" % self.width)\n        if self.max_lines is not None:\n            if self.max_lines > 1:\n",
        "                indent = self.subsequent_indent\n            else:\n                indent = self.initial_indent\n            if len(indent) + len(self.placeholder.lstrip()) > self.width:\n                raise ValueError(\"placeholder too large for max width\")\n        # (The chunks are taken from the end of the list: it's turned round.)\n        chunks.reverse()\n        while chunks:\n            cur_line = []\n            cur_len = 0\n            if lines:\n                indent = self.subsequent_indent\n            else:\n                indent = self.initial_indent\n            width = self.width - len(indent)\n            if self.drop_whitespace and chunks[-1].strip() == \"\" and lines:\n                chunks.pop()\n            while chunks:\n                l = len(chunks[-1])\n                if cur_len + l <= width:\n                    cur_line.append(chunks.pop())\n                    cur_len += l\n                else:\n                    break\n            if chunks and len(chunks[-1]) > width:\n                self._handle_long_word(chunks, cur_line, cur_len, width)\n                cur_len = sum([len(c) for c in cur_line])\n            if self.drop_whitespace and cur_line and cur_line[-1].strip() == \"\":\n                cur_len -= len(cur_line[-1])\n                cur_line.pop()\n            if cur_line:\n                if (self.max_lines is None or len(lines) + 1 < self.max_lines or\n                        (not chunks or self.drop_whitespace and len(chunks) == 1 and not chunks[0].strip())\n                        and cur_len <= width):\n                    lines.append(indent + \"\".join(cur_line))\n                else:\n                    placed = False\n                    while cur_line:\n                        if cur_line[-1].strip() and cur_len + len(self.placeholder) <= width:\n                            cur_line.append(self.placeholder)\n",
        "                            lines.append(indent + \"\".join(cur_line))\n                            placed = True\n                            break\n                        cur_len -= len(cur_line[-1])\n                        cur_line.pop()\n                    if not placed:\n                        joined = False\n                        if lines:\n                            prev_line = lines[-1].rstrip()\n                            if len(prev_line) + len(self.placeholder) <= self.width:\n                                lines[-1] = prev_line + self.placeholder\n                                joined = True\n                        if not joined:\n                            lines.append(indent + self.placeholder.lstrip())\n                    break\n        return lines\n\n    def _split_chunks(self, text):\n        return self._split(self._munge_whitespace(text))\n\n    def wrap(self, text):\n        \"\"\"The text's words on lines of at most `width` characters.\"\"\"\n        chunks = self._split_chunks(text)\n        if self.fix_sentence_endings:\n            self._fix_sentence_endings(chunks)\n        return self._wrap_chunks(chunks)\n\n    def fill(self, text):\n        \"\"\"The wrapped lines, as one text.\"\"\"\n        return \"\\n\".join(self.wrap(text))\n\n\ndef wrap(text, width=70, **kwargs):\n    \"\"\"A paragraph as a list of lines of at most `width` characters.\"\"\"\n    return TextWrapper(width=width, **kwargs).wrap(text)\n\n\ndef fill(text, width=70, **kwargs):\n    \"\"\"A paragraph wrapped to `width` characters, as one text.\"\"\"\n    return TextWrapper(width=width, **kwargs).fill(text)\n",
        "\n\ndef shorten(text, width, **kwargs):\n    \"\"\"The text on one line of at most `width` characters, cut with [...] if it's longer.\"\"\"\n    w = TextWrapper(width=width, max_lines=1, **kwargs)\n    return w.fill(\" \".join(text.strip().split()))\n\n\n_whitespace_only_re = re.compile(\"^[ \\t]+$\", re.MULTILINE)\n_leading_whitespace_re = re.compile(\"(^[ \\t]*)(?:[^ \\t\\n])\", re.MULTILINE)\n\n\ndef dedent(text):\n    \"\"\"The text without the white space every line starts with.\"\"\"\n    margin = None\n    text = _whitespace_only_re.sub(\"\", text)\n    indents = _leading_whitespace_re.findall(text)\n    for indent in indents:\n        if margin is None:\n            margin = indent\n        elif indent.startswith(margin):\n            pass\n        elif margin.startswith(indent):\n            margin = indent\n        else:\n            # The part they both start with.\n            i = 0\n            while i < len(margin) and i < len(indent) and margin[i] == indent[i]:\n                i += 1\n            margin = margin[:i]\n    if margin:\n        text = re.sub(r\"(?m)^\" + margin, \"\", text)\n    return text\n\n\ndef indent(text, prefix, predicate=None):\n    \"\"\"The text with `prefix` before each line (each that isn't only white space).\"\"\"\n    out = []\n    for line in _lines_with_ends(text):\n        if predicate is None:\n",
        "            wanted = line.strip()\n        else:\n            wanted = predicate(line)\n        out.append(prefix + line if wanted else line)\n    return \"\".join(out)\n",
    ].joined()
}
