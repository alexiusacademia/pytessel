// Python's built-in functions: print, len, range, sorted, isinstance, …

// A keyword argument's value, or `.absent`.
fn keyword(_ names: [String], _ values: [Value], _ name: String) -> Value {
    if names.isEmpty {
        return Value.absent
    }
    if let i = names.index(of: name) {
        return values[i]
    }
    Value.absent
}

// Checks how many arguments a built-in function got. False (with a
// TypeError raised) when it's not between `least` and `most`.
fn arity(_ it: bind Interp, _ name: String, _ args: [Value], _ least: Int, _ most: Int) -> Bool {
    if args.count >= least && args.count <= most {
        return true
    }
    if least == most {
        let s = if least == 1 { "" } else { "s" }
        it.throw("TypeError", "{name}() takes exactly {least} argument{s} ({args.count} given)")
    } else if args.count < least {
        let s = if least == 1 { "" } else { "s" }
        it.throw("TypeError", "{name}() takes at least {least} argument{s} ({args.count} given)")
    } else {
        let s = if most == 1 { "" } else { "s" }
        it.throw("TypeError", "{name}() takes at most {most} argument{s} ({args.count} given)")
    }
    false
}

fn lengthOf(_ it: bind Interp, _ v: Value) -> Value {
    match v {
        .list(id) -> .int(i: it.lists[id].count)
        .str(s) -> .int(i: s.count)
        .dict(id) -> .int(i: it.dicts[id].live)
        .tuple(id) -> .int(i: it.lists[id].count)
        .set(id) -> .int(i: it.dicts[id].live)
        .range(start, stop, step) -> .int(i: rangeLength(start, stop, step))
        .bytes(id, _) -> .int(i: it.blobs[id].count)
        .klass(id) -> {
            let method = metaMethod(it, id, "__len__")
            if method != Value.absent {
                return it.callValue(method, [v], [], [])
            }
            it.throw("TypeError", "object of type 'type' has no len()")
        }
        .instance(id) -> {
            let method = classAttr(it, it.instances[id].cls, "__len__")
            if method != Value.absent {
                return it.callValue(method, [v], [], [])
            }
            it.throw("TypeError", "object of type '{typeName(it, v)}' has no len()")
        }
        _ -> it.throw("TypeError", "object of type '{typeName(it, v)}' has no len()")
    }
}

// Sorts values as Python's `sorted` does: smallest first by `<` (on what
// `key` gives for each, if there's a key function), keeping the order of
// equal ones; `reverse` for largest first.
fn sortValues(_ it: bind Interp, _ items: [Value], _ key: Value, _ reverse: Bool) -> [Value] {
    var keys = items
    if key != Value.absent && key != Value.none {
        keys = []
        for item in items {
            let k = it.callValue(key, [item], [], [])
            if it.signal != .none {
                return items
            }
            keys.append(k)
        }
    }
    // A merge sort of the items' places.
    var order: [Int] = []
    for i in items.indices {
        order.append(i)
    }
    var width = 1
    while width < order.count {
        var merged: [Int] = []
        var start = 0
        while start < order.count {
            let middle = if start + width < order.count { start + width } else { order.count }
            let end = if start + 2 * width < order.count { start + 2 * width } else { order.count }
            var i = start
            var j = middle
            while i < middle && j < end {
                // The right one goes first only if it's really before the left one.
                let rightFirst = if reverse {
                    pyLess(it, keys[order[i]], keys[order[j]], "<")
                } else {
                    pyLess(it, keys[order[j]], keys[order[i]], "<")
                }
                if it.signal != .none {
                    return items
                }
                if rightFirst {
                    merged.append(order[j])
                    j += 1
                } else {
                    merged.append(order[i])
                    i += 1
                }
            }
            while i < middle {
                merged.append(order[i])
                i += 1
            }
            while j < end {
                merged.append(order[j])
                j += 1
            }
            start += 2 * width
        }
        order = merged
        width *= 2
    }
    var out: [Value] = []
    for i in order {
        out.append(items[i])
    }
    out
}

// min(…) and max(…).
fn extreme(_ it: bind Interp, _ name: String, _ args: [Value], _ kwNames: [String], _ kwValues: [Value]) -> Value {
    var items = args
    if args.count == 1 {
        items = iterate(it, args[0])
        if it.signal != .none {
            return Value.none
        }
    }
    if items.isEmpty {
        let fallback = keyword(kwNames, kwValues, "default")
        if fallback != Value.absent {
            return fallback
        }
        if args.isEmpty {
            return it.throw("TypeError", "{name} expected at least 1 argument, got 0")
        }
        return it.throw("ValueError", "{name}() arg is an empty sequence")
    }
    let key = keyword(kwNames, kwValues, "key")
    var best = items[0]
    var bestKey = best
    let keyed = key != Value.absent && key != Value.none
    if keyed {
        bestKey = it.callValue(key, [best], [], [])
        if it.signal != .none {
            return Value.none
        }
    }
    for i in 1..items.count {
        var k = items[i]
        if keyed {
            k = it.callValue(key, [items[i]], [], [])
            if it.signal != .none {
                return Value.none
            }
        }
        let better = if name == "min" { pyLess(it, k, bestKey, "<") } else { pyLess(it, bestKey, k, ">") }
        if it.signal != .none {
            return Value.none
        }
        if better {
            best = items[i]
            bestKey = k
        }
    }
    best
}

// int(text, base).
fn parseInteger(_ it: bind Interp, _ text: String, _ base: Int) -> Value {
    var s = text.trim().replace("_", with: "").lowercase()
    var negative = false
    if s.hasPrefix("-") {
        negative = true
        s = s.substring(from: 1, to: s.count)
    } else if s.hasPrefix("+") {
        s = s.substring(from: 1, to: s.count)
    }
    var radix = base
    if s.hasPrefix("0x") && (base == 16 || base == 0) {
        radix = 16
        s = s.substring(from: 2, to: s.count)
    } else if s.hasPrefix("0b") && (base == 2 || base == 0) {
        radix = 2
        s = s.substring(from: 2, to: s.count)
    } else if s.hasPrefix("0o") && (base == 8 || base == 0) {
        radix = 8
        s = s.substring(from: 2, to: s.count)
    } else if base == 0 {
        radix = 10
    }
    var n = 0
    var ok = s != ""
    for c in s.characters {
        let d = "0123456789abcdefghijklmnopqrstuvwxyz".find(c) ?? 99
        if d >= radix {
            ok = false
            break
        }
        if let scaled = mulChecked(n, radix) {
            n = scaled.wrappingAdd(d)
            if n < 0 {
                return tooLarge(it)
            }
        } else {
            return tooLarge(it)
        }
    }
    if !ok {
        return it.throw("ValueError", "invalid literal for int() with base {base}: {strRepr(text)}")
    }
    Value.int(i: if negative { -n } else { n })
}

fn toInt(_ it: bind Interp, _ args: [Value]) -> Value {
    if args.isEmpty {
        return .int(i: 0)
    }
    let v = args[0]
    match v {
        .int(_) -> v
        .bool(b) -> .int(i: if b { 1 } else { 0 })
        .float(f) -> {
            if f.isNaN {
                return it.throw("ValueError", "cannot convert float NaN to integer")
            }
            if !f.isFinite {
                return it.throw("OverflowError", "cannot convert float infinity to integer")
            }
            if f >= 9.3e18 || f <= -9.3e18 {
                return tooLarge(it)
            }
            Value.int(i: Int(f))
        }
        .str(s) -> {
            var base = 10
            if args.count > 1 {
                base = intOf(args[1]) ?? 10
            }
            parseInteger(it, s, base)
        }
        .bytes(id, _) -> {
            // int(b"42"): the digits, as text.
            var base = 10
            if args.count > 1 {
                base = intOf(args[1]) ?? 10
            }
            let parsed = parseInteger(it, Data(bytes: it.blobs[id]).text ?? "?", base)
            if it.signal == .raising && it.blobs[id].count < 200 {
                it.signal = .none
                return it.throw("ValueError", "invalid literal for int() with base {base}: {toRepr(it, v)}")
            }
            parsed
        }
        .instance(id) -> {
            let method = classAttr(it, it.instances[id].cls, "__int__")
            if method != Value.absent {
                return it.callValue(method, [v], [], [])
            }
            it.throw("TypeError", "int() argument must be a string or a number, not '{typeName(it, v)}'")
        }
        _ -> it.throw("TypeError", "int() argument must be a string or a number, not '{typeName(it, v)}'")
    }
}

fn toFloat(_ it: bind Interp, _ args: [Value]) -> Value {
    if args.isEmpty {
        return .float(f: 0.0)
    }
    let v = args[0]
    if let f = floatOf(v) {
        return .float(f: f)
    }
    match v {
        .str(s) -> {
            let t = s.trim().lowercase().replace("_", with: "")
            if t == "inf" || t == "+inf" || t == "infinity" {
                return .float(f: 1.0e308 * 10.0)
            }
            if t == "-inf" || t == "-infinity" {
                return .float(f: -1.0e308 * 10.0)
            }
            if t == "nan" || t == "+nan" || t == "-nan" {
                let zero = 0.0
                return .float(f: zero / zero)
            }
            // (Tessel reads a number that has a digit on both sides of the point.)
            var fixed = t
            if fixed.hasPrefix(".") {
                fixed = "0" + fixed
            } else if fixed.hasPrefix("-.") {
                fixed = "-0" + fixed.substring(from: 1, to: fixed.count)
            } else if fixed.hasPrefix("+") {
                fixed = fixed.substring(from: 1, to: fixed.count)
            }
            if fixed.hasSuffix(".") {
                fixed += "0"
            }
            fixed = fixed.replace(".e", with: ".0e")
            if let f = Float(fixed) {
                return .float(f: f)
            }
            it.throw("ValueError", "could not convert string to float: {strRepr(s)}")
        }
        .instance(id) -> {
            let method = classAttr(it, it.instances[id].cls, "__float__")
            if method != Value.absent {
                return it.callValue(method, [v], [], [])
            }
            it.throw("TypeError", "float() argument must be a string or a real number, not '{typeName(it, v)}'")
        }
        _ -> it.throw("TypeError", "float() argument must be a string or a real number, not '{typeName(it, v)}'")
    }
}

// isinstance(v, kind): `kind` is a class, a built-in type, or a tuple of them.
fn isInstance(_ it: bind Interp, _ v: Value, _ kind: Value) -> Bool {
    match kind {
        .klass(cls) -> {
            match v {
                .instance(id) -> isSubclass(it, it.instances[id].cls, cls)
                .klass(c) -> {
                    // (A class is one of its metaclass's, and of `type`'s.)
                    let meta = if it.classes[c].meta >= 0 { it.classes[c].meta } else { typeClass(it) }
                    isSubclass(it, meta, cls)
                }
                _ -> cls == (it.classIds["object"] ?? -1)
            }
        }
        .builtin(name) -> {
            if name == "object" {
                return true
            }
            let type = typeName(it, v)
            if type == name {
                return true
            }
            // (A bool is an int, as in Python.)
            if name == "int" && type == "bool" {
                return true
            }
            if name == "type" {
                match v {
                    .klass(_) -> { return true }
                    _ -> { return false }
                }
            }
            false
        }
        .tuple(id) -> {
            for k in it.lists[id] {
                if isInstance(it, v, k) {
                    return true
                }
            }
            false
        }
        _ -> {
            it.throw("TypeError", "isinstance() arg 2 must be a type, a tuple of types, or a union")
            false
        }
    }
}

// round(x) and round(x, digits): halves go to the even neighbor.
fn roundValue(_ it: bind Interp, _ args: [Value]) -> Value {
    let v = args[0]
    var digits = 0
    var hasDigits = false
    if args.count > 1 && args[1] != Value.none {
        digits = intOf(args[1]) ?? 0
        hasDigits = true
    }
    match v {
        .float(f) -> {
            if !hasDigits {
                if f.isNaN {
                    return it.throw("ValueError", "cannot convert float NaN to integer")
                }
                if !f.isFinite {
                    return it.throw("OverflowError", "cannot convert float infinity to integer")
                }
                return .int(i: Int(roundHalfEven(f)))
            }
            if digits > 15 {
                return v
            }
            if digits >= 0 {
                // (Through its exact decimal digits: 2.675 is really
                // 2.67499999…, and rounds down.)
                return .float(f: Float(f.formatted(decimals: digits)) ?? f)
            }
            let scale = pow(10.0, Float(-digits))
            Value.float(f: roundHalfEven(f / scale) * scale)
        }
        _ -> {
            if let i = intOf(v) {
                if digits >= 0 {
                    return .int(i: i)
                }
                var scale = 1
                for _ in 0..(-digits) {
                    scale *= 10
                }
                let rounded = Int(roundHalfEven(Float(i) / Float(scale))) * scale
                return .int(i: rounded)
            }
            it.throw("TypeError", "type {typeName(it, v)} doesn't define __round__ method")
        }
    }
}

fn roundHalfEven(_ x: Float) -> Float {
    let below = floor(x)
    let part = x - below
    if part < 0.5 {
        return below
    }
    if part > 0.5 {
        return below + 1.0
    }
    // Exactly half: to the even one.
    if Int(below) % 2 == 0 { below } else { below + 1.0 }
}

fn printValues(_ it: bind Interp, _ args: [Value], _ kwNames: [String], _ kwValues: [Value]) -> Value {
    var separator = " "
    var end = "\n"
    var toError = false
    if !kwNames.isEmpty {
        match keyword(kwNames, kwValues, "sep") {
            .str(s) -> { separator = s }
            _ -> {}
        }
        match keyword(kwNames, kwValues, "end") {
            .str(s) -> { end = s }
            _ -> {}
        }
        match keyword(kwNames, kwValues, "file") {
            .module(m) -> { toError = m == "sys.stderr" }
            .file(id) -> {
                // print(…, file=f)
                var text = ""
                for i in args.indices {
                    if i > 0 {
                        text += separator
                    }
                    text += toStr(it, args[i])
                }
                it.files[id].pending += text + end
                return Value.none
            }
            _ -> {}
        }
    }
    var text = ""
    if args.count == 1 {
        match args[0] {
            .str(s) -> { text = s }
            _ -> { text = toStr(it, args[0]) }
        }
    } else {
        for i in args.indices {
            if i > 0 {
                text += separator
            }
            text += toStr(it, args[i])
            if it.signal != .none {
                return Value.none
            }
        }
    }
    if it.signal != .none {
        return Value.none
    }
    emit(it, text + end, toError: toError)
    Value.none
}

fn openPath(_ it: bind Interp, _ args: [Value], _ kwNames: [String], _ kwValues: [Value]) -> Value {
    var path = ""
    match args[0] {
        .str(s) -> { path = s }
        _ -> { return it.throw("TypeError", "open() needs a file's path, not '{typeName(it, args[0])}'") }
    }
    var mode = "r"
    if args.count > 1 {
        match args[1] {
            .str(s) -> { mode = s }
            _ -> {}
        }
    }
    match keyword(kwNames, kwValues, "mode") {
        .str(s) -> { mode = s }
        _ -> {}
    }
    var file = PyFile(path: path, mode: mode)
    if mode.contains("b") {
        // A file of bytes.
        file.binary = true
        if mode.contains("r") {
            if let data = readData(path) {
                file.data = data.bytes
            } else {
                return it.throw("FileNotFoundError", "[Errno 2] No such file or directory: {strRepr(path)}")
            }
        } else if mode.contains("w") {
            if !writeData(path: path, data: Data()) {
                return it.throw("OSError", "can't write {strRepr(path)}")
            }
        } else if !mode.contains("a") && !mode.contains("x") {
            return it.throw("ValueError", "invalid mode: {strRepr(mode)}")
        }
        it.files.append(file)
        return Value.file(id: it.files.count - 1)
    }
    if mode.contains("r") {
        if let text = readFile(path: path) {
            // Each line with its line break, as Python gives them.
            var lines: [String] = []
            let parts = text.split("\n")
            for i in parts.indices {
                if i < parts.count - 1 {
                    lines.append(parts[i] + "\n")
                } else if parts[i] != "" {
                    lines.append(parts[i])
                }
            }
            file.lines = lines
        } else {
            return it.throw("FileNotFoundError", "[Errno 2] No such file or directory: {strRepr(path)}")
        }
    } else if mode.contains("w") {
        if !writeFile(path: path, text: "") {
            return it.throw("OSError", "can't write {strRepr(path)}")
        }
    } else if !mode.contains("a") && !mode.contains("x") {
        return it.throw("ValueError", "invalid mode: {strRepr(mode)}")
    }
    it.files.append(file)
    Value.file(id: it.files.count - 1)
}

// Writes what a file has waiting.
fn flushFile(_ it: bind Interp, _ id: Int) {
    if it.files[id].binary {
        if !it.files[id].mode.contains("r") && !it.files[id].data.isEmpty {
            appendData(path: it.files[id].path, data: Data(bytes: it.files[id].data))
            it.files[id].data = []
        }
        return
    }
    if it.files[id].pending != "" {
        appendFile(path: it.files[id].path, text: it.files[id].pending)
        it.files[id].pending = ""
    }
}

fn closeFile(_ it: bind Interp, _ id: Int) {
    flushFile(it, id)
    it.files[id].closed = true
}

// eval(text) and exec(text): Python code given as text.
fn runSource(_ it: bind Interp, _ source: String, _ asExpression: Bool) -> Value {
    parseInto(it.prog, source)
    if it.prog.error != "" {
        it.throw("SyntaxError", "{it.prog.error} (<string>, line {it.prog.errorLine})")
        // (What's wrong and where, as `e.msg` and `e.lineno`.)
        match it.exc {
            .instance(id) -> {
                it.instances[id].fields["msg"] = .str(s: it.prog.error)
                it.instances[id].fields["lineno"] = .int(i: it.prog.errorLine)
            }
            _ -> {}
        }
        return Value.none
    }
    let body = it.prog.body
    if asExpression {
        if body.count == 1 {
            match it.prog.nodes[body[0]] {
                .exprStmt(value) -> { return it.eval(value) }
                _ -> {}
            }
        }
        return it.throw("SyntaxError", "invalid syntax")
    }
    it.execBlock(body)
    Value.none
}

fn callBuiltin(_ it: bind Interp, _ name: String, _ args: [Value], _ kwNames: [String], _ kwValues: [Value]) -> Value {
    if it.sandbox && name == "open" {
        return it.throw("PermissionError", "{name}() isn't available here")
    }
    match name {
        "__host__" -> callHost(it, args)
        "len" -> {
            if !arity(it, name, args, 1, 1) {
                return Value.none
            }
            lengthOf(it, args[0])
        }
        "range" -> {
            if !arity(it, name, args, 1, 3) {
                return Value.none
            }
            var numbers: [Int] = []
            for a in args {
                if let i = intOf(a) {
                    numbers.append(i)
                } else {
                    return it.throw("TypeError", "'{typeName(it, a)}' object cannot be interpreted as an integer")
                }
            }
            if numbers.count == 1 {
                Value.range(start: 0, stop: numbers[0], step: 1)
            } else if numbers.count == 2 {
                Value.range(start: numbers[0], stop: numbers[1], step: 1)
            } else if numbers[2] == 0 {
                it.throw("ValueError", "range() arg 3 must not be zero")
            } else {
                Value.range(start: numbers[0], stop: numbers[1], step: numbers[2])
            }
        }
        "print" -> printValues(it, args, kwNames, kwValues)
        "str" -> {
            if args.isEmpty {
                return .str(s: "")
            }
            if args.count > 1 || !kwNames.isEmpty {
                // str(b"…", "utf-8"): bytes, decoded.
                if let codec = codecArgs(it, name, args, 1, kwNames, kwValues) {
                    if let b = bytesOf(it, args[0]) {
                        return decodeBytes(it, b, codec[0], codec[1])
                    }
                    return it.throw("TypeError", "decoding to str: need a bytes-like object, {typeName(it, args[0])} found")
                }
                return Value.none
            }
            Value.str(s: toStr(it, args[0]))
        }
        "int" -> toInt(it, args)
        "bytes", "bytearray" -> makeBytes(it, name, args, kwNames, kwValues)
        "slice" -> makeSlice(it, args)
        "float" -> toFloat(it, args)
        "isinstance" -> {
            if !arity(it, name, args, 2, 2) {
                return Value.none
            }
            Value.bool(b: isInstance(it, args[0], args[1]))
        }
        "bool" -> {
            if args.isEmpty {
                return .bool(b: false)
            }
            Value.bool(b: truthy(it, args[0]))
        }
        "list" -> {
            if args.isEmpty {
                return it.newList([])
            }
            let items = iterate(it, args[0])
            if it.signal != .none {
                return Value.none
            }
            it.newList(items)
        }
        "tuple" -> {
            if args.isEmpty {
                return it.newTuple([])
            }
            let items = iterate(it, args[0])
            if it.signal != .none {
                return Value.none
            }
            it.newTuple(items)
        }
        "dict" -> {
            let id = it.newDict()
            if !args.isEmpty {
                dictUpdate(it, id, args[0])
                if it.signal != .none {
                    return Value.none
                }
            }
            for i in kwNames.indices {
                dictSet(it.dicts[id], .str(s: kwNames[i]), "s" + kwNames[i], kwValues[i])
            }
            Value.dict(id: id)
        }
        "set", "frozenset" -> {
            if args.isEmpty {
                return makeSet(it, [])
            }
            let items = iterate(it, args[0])
            if it.signal != .none {
                return Value.none
            }
            makeSet(it, items)
        }
        "abs" -> {
            if !arity(it, name, args, 1, 1) {
                return Value.none
            }
            match args[0] {
                .float(f) -> { return .float(f: abs(f)) }
                .instance(id) -> {
                    let method = classAttr(it, it.instances[id].cls, "__abs__")
                    if method != Value.absent {
                        return it.callValue(method, args, [], [])
                    }
                }
                _ -> {}
            }
            if let i = intOf(args[0]) {
                if i == minInt() {
                    return tooLarge(it)
                }
                return .int(i: abs(i))
            }
            it.throw("TypeError", "bad operand type for abs(): '{typeName(it, args[0])}'")
        }
        "min", "max" -> extreme(it, name, args, kwNames, kwValues)
        "sum" -> {
            if !arity(it, name, args, 1, 2) {
                return Value.none
            }
            var total = if args.count > 1 { args[1] } else { Value.int(i: 0) }
            match args[0] {
                .iterator(_) -> {
                    // (As its values come.)
                    while true {
                        let item = nextValue(it, args[0])
                        if it.signal != .none {
                            return Value.none
                        }
                        if isAbsent(item) {
                            return total
                        }
                        total = binaryOp(it, .add, total, item)
                        if it.signal != .none {
                            return Value.none
                        }
                    }
                }
                _ -> {}
            }
            let items = iterate(it, args[0])
            if it.signal != .none {
                return Value.none
            }
            for item in items {
                total = binaryOp(it, .add, total, item)
                if it.signal != .none {
                    return Value.none
                }
            }
            total
        }
        "sorted" -> {
            if !arity(it, name, args, 1, 1) {
                return Value.none
            }
            let items = iterate(it, args[0])
            if it.signal != .none {
                return Value.none
            }
            let reverse = keyword(kwNames, kwValues, "reverse")
            let backwards = reverse != Value.absent && truthy(it, reverse)
            let sorted = sortValues(it, items, keyword(kwNames, kwValues, "key"), backwards)
            if it.signal != .none {
                return Value.none
            }
            it.newList(sorted)
        }
        "enumerate" -> {
            if !arity(it, name, args, 1, 2) {
                return Value.none
            }
            let source = getIter(it, args[0])
            if it.signal != .none {
                return Value.none
            }
            var start = 0
            if args.count > 1 {
                start = intOf(args[1]) ?? 0
            }
            match keyword(kwNames, kwValues, "start") {
                .int(i) -> { start = i }
                _ -> {}
            }
            makeIter(it, PyIter(pos: start, kind: "enumerate", mode: IterMode.enumerate, sources: [source]))
        }
        "zip" -> {
            var sources: [Value] = []
            for a in args {
                let source = getIter(it, a)
                if it.signal != .none {
                    return Value.none
                }
                sources.append(source)
            }
            makeIter(it, PyIter(kind: "zip", mode: IterMode.zip, sources: sources))
        }
        "map" -> {
            if args.count < 2 {
                return it.throw("TypeError", "map() must have at least two arguments.")
            }
            var sources: [Value] = []
            for i in 1..args.count {
                let source = getIter(it, args[i])
                if it.signal != .none {
                    return Value.none
                }
                sources.append(source)
            }
            makeIter(it, PyIter(kind: "map", mode: IterMode.map, sources: sources, function: args[0]))
        }
        "filter" -> {
            if !arity(it, name, args, 2, 2) {
                return Value.none
            }
            let source = getIter(it, args[1])
            if it.signal != .none {
                return Value.none
            }
            makeIter(it, PyIter(kind: "filter", mode: IterMode.filter, sources: [source], function: args[0]))
        }
        "reversed" -> {
            if !arity(it, name, args, 1, 1) {
                return Value.none
            }
            match args[0] {
                .range(start, stop, step) -> {
                    // Backwards from its last number, without making them all.
                    let count = rangeLength(start, stop, step)
                    if count == 0 {
                        return it.newIterator([], "range_iterator")
                    }
                    let last = start + (count - 1) * step
                    return makeIter(it, PyIter(pos: last, kind: "range_iterator", mode: IterMode.range,
                                               stop: start.wrappingSubtract(step), step: 0 - step))
                }
                .instance(id) -> {
                    let method = classAttr(it, it.instances[id].cls, "__reversed__")
                    if method != Value.absent {
                        return it.callValue(method, [args[0]], [], [])
                    }
                }
                .iterator(_) -> {
                    return it.throw("TypeError", "'{typeName(it, args[0])}' object is not reversible")
                }
                _ -> {}
            }
            let items = iterate(it, args[0])
            if it.signal != .none {
                return Value.none
            }
            it.newIterator(items.reversed(), "reversed")
        }
        "any", "all" -> {
            if !arity(it, name, args, 1, 1) {
                return Value.none
            }
            // (It stops at the first value that settles it.)
            let source = getIter(it, args[0])
            if it.signal != .none {
                return Value.none
            }
            while true {
                let item = nextValue(it, source)
                if it.signal != .none {
                    return Value.none
                }
                if isAbsent(item) {
                    break
                }
                let yes = truthy(it, item)
                if it.signal != .none {
                    return Value.none
                }
                if yes && name == "any" {
                    return .bool(b: true)
                }
                if !yes && name == "all" {
                    return .bool(b: false)
                }
            }
            Value.bool(b: name == "all")
        }
        "repr", "ascii" -> {
            if !arity(it, name, args, 1, 1) {
                return Value.none
            }
            Value.str(s: toRepr(it, args[0]))
        }
        "type" -> {
            if args.count == 3 {
                // type(name, bases, namespace): a new class.
                return typeNew(it, -1, args, kwNames, kwValues)
            }
            if args.count != 1 {
                return it.throw("TypeError", "type() takes 1 or 3 arguments")
            }
            typeOf(it, args[0])
        }
        "__abstractmethod__" -> {
            if !arity(it, name, args, 1, 1) {
                return Value.none
            }
            Value.wrapper(kind: 3, id: it.newCell(args[0]))
        }
        "issubclass" -> {
            if !arity(it, name, args, 2, 2) {
                return Value.none
            }
            // (`type` and `object` among them, as the classes they are.)
            var first = args[0]
            var second = args[1]
            if first == Value.builtin(name: "type") {
                first = .klass(id: typeClass(it))
            }
            if second == Value.builtin(name: "type") {
                second = .klass(id: typeClass(it))
            }
            match first {
                .builtin(b) -> {
                    if isTypeName(b) && second == Value.klass(id: it.classIds["object"] ?? -1) {
                        return .bool(b: true)
                    }
                }
                _ -> {}
            }
            match first {
                .klass(a) -> {
                    match second {
                        .klass(b) -> { return .bool(b: isSubclass(it, a, b)) }
                        .tuple(t) -> {
                            for k in it.lists[t] {
                                match k {
                                    .klass(b) -> {
                                        if isSubclass(it, a, b) {
                                            return .bool(b: true)
                                        }
                                    }
                                    _ -> {}
                                }
                            }
                            return .bool(b: false)
                        }
                        _ -> {}
                    }
                }
                _ -> {}
            }
            Value.bool(b: args[0] == args[1])
        }
        "input" -> {
            if it.sandbox {
                return it.throw("PermissionError", "input() isn't available here")
            }
            if !args.isEmpty {
                emit(it, toStr(it, args[0]), toError: false)
            }
            if let text = readLine() {
                return .str(s: text)
            }
            it.throw("EOFError", "EOF when reading a line")
        }
        "ord" -> {
            if !arity(it, name, args, 1, 1) {
                return Value.none
            }
            match args[0] {
                .str(s) -> {
                    if s.count != 1 {
                        return it.throw("TypeError", "ord() expected a character, but string of length {s.count} found")
                    }
                    Value.int(i: ordOf(s))
                }
                .bytes(id, _) -> {
                    if it.blobs[id].count != 1 {
                        return it.throw("TypeError", "ord() expected a character, but string of length {it.blobs[id].count} found")
                    }
                    Value.int(i: it.blobs[id][0])
                }
                _ -> it.throw("TypeError", "ord() expected string of length 1, but {typeName(it, args[0])} found")
            }
        }
        "chr" -> {
            if !arity(it, name, args, 1, 1) {
                return Value.none
            }
            if let i = intOf(args[0]) {
                if i < 0 || i > 0x10FFFF {
                    return it.throw("ValueError", "chr() arg not in range(0x110000)")
                }
                return .str(s: chrOf(i))
            }
            it.throw("TypeError", "an integer is required (got type {typeName(it, args[0])})")
        }
        "round" -> {
            if !arity(it, name, args, 1, 2) {
                return Value.none
            }
            roundValue(it, args)
        }
        "divmod" -> {
            if !arity(it, name, args, 2, 2) {
                return Value.none
            }
            let q = binaryOp(it, .floorDiv, args[0], args[1])
            if it.signal != .none {
                return Value.none
            }
            let r = binaryOp(it, .mod, args[0], args[1])
            it.newTuple([q, r])
        }
        "pow" -> {
            if !arity(it, name, args, 2, 3) {
                return Value.none
            }
            if args.count == 3 {
                // (base ** exponent) % modulus, without the huge number between.
                if let base = intOf(args[0]) {
                    if let exponent = intOf(args[1]) {
                        if let modulus = intOf(args[2]) {
                            if modulus == 0 {
                                return it.throw("ValueError", "pow() 3rd argument cannot be 0")
                            }
                            if exponent < 0 {
                                return it.throw("ValueError", "pow() with a negative exponent and a modulus isn't supported")
                            }
                            var result = 1 % modulus
                            var b = base % modulus
                            var e = exponent
                            while e > 0 {
                                if e % 2 == 1 {
                                    result = (mulChecked(result, b) ?? 0) % modulus
                                }
                                b = (mulChecked(b, b) ?? 0) % modulus
                                e = e / 2
                            }
                            if result != 0 && ((result < 0) != (modulus < 0)) {
                                result += modulus
                            }
                            return .int(i: result)
                        }
                    }
                }
                return it.throw("TypeError", "pow() 3rd argument not allowed unless all arguments are integers")
            }
            binaryOp(it, .pow, args[0], args[1])
        }
        "hex", "bin", "oct" -> {
            if !arity(it, name, args, 1, 1) {
                return Value.none
            }
            if let i = intOf(args[0]) {
                if name == "hex" {
                    return .str(s: intInBase(i, base: 16, prefix: "0x"))
                }
                if name == "bin" {
                    return .str(s: intInBase(i, base: 2, prefix: "0b"))
                }
                return .str(s: intInBase(i, base: 8, prefix: "0o"))
            }
            it.throw("TypeError", "'{typeName(it, args[0])}' object cannot be interpreted as an integer")
        }
        "callable" -> {
            if !arity(it, name, args, 1, 1) {
                return Value.none
            }
            match args[0] {
                .function(_), .builtin(_), .bound(_), .klass(_) -> .bool(b: true)
                .instance(id) -> .bool(b: classAttr(it, it.instances[id].cls, "__call__") != Value.absent)
                _ -> .bool(b: false)
            }
        }
        "getattr" -> {
            if !arity(it, name, args, 2, 3) {
                return Value.none
            }
            match args[1] {
                .str(attribute) -> {
                    let v = getAttr(it, args[0], attribute)
                    if it.signal == .raising && args.count == 3 {
                        if exceptionMatches(it, it.exc, .klass(id: it.classIds["AttributeError"] ?? -1)) {
                            it.signal = .none
                            return args[2]
                        }
                    }
                    v
                }
                _ -> it.throw("TypeError", "attribute name must be string, not '{typeName(it, args[1])}'")
            }
        }
        "hasattr" -> {
            if !arity(it, name, args, 2, 2) {
                return Value.none
            }
            match args[1] {
                .str(attribute) -> {
                    getAttr(it, args[0], attribute)
                    if it.signal == .raising {
                        if exceptionMatches(it, it.exc, .klass(id: it.classIds["AttributeError"] ?? -1)) {
                            it.signal = .none
                            return .bool(b: false)
                        }
                        return Value.none
                    }
                    Value.bool(b: true)
                }
                _ -> it.throw("TypeError", "attribute name must be string, not '{typeName(it, args[1])}'")
            }
        }
        "setattr" -> {
            if !arity(it, name, args, 3, 3) {
                return Value.none
            }
            match args[1] {
                .str(attribute) -> {
                    setAttr(it, args[0], attribute, args[2])
                    Value.none
                }
                _ -> it.throw("TypeError", "attribute name must be string, not '{typeName(it, args[1])}'")
            }
        }
        "delattr" -> {
            if !arity(it, name, args, 2, 2) {
                return Value.none
            }
            match args[1] {
                .str(attribute) -> {
                    deleteAttr(it, args[0], attribute)
                    Value.none
                }
                _ -> it.throw("TypeError", "attribute name must be string, not '{typeName(it, args[1])}'")
            }
        }
        "iter" -> {
            if !arity(it, name, args, 1, 2) {
                return Value.none
            }
            if args.count == 2 {
                // iter(function, sentinel): function() until it gives the sentinel.
                return makeIter(it, PyIter(kind: "callable_iterator", mode: IterMode.sentinel, function: args[0], sentinel: args[1]))
            }
            getIter(it, args[0])
        }
        "next" -> {
            if !arity(it, name, args, 1, 2) {
                return Value.none
            }
            match args[0] {
                .instance(id) -> {
                    let method = classAttr(it, it.instances[id].cls, "__next__")
                    if method == Value.absent {
                        return it.throw("TypeError", "'{typeName(it, args[0])}' object is not an iterator")
                    }
                    let v = it.callValue(method, [args[0]], [], [])
                    if it.signal == .raising && args.count > 1 {
                        if exceptionMatches(it, it.exc, .klass(id: it.classIds["StopIteration"] ?? -1)) {
                            it.signal = .none
                            return args[1]
                        }
                    }
                    v
                }
                _ -> {
                    it.stopValue = .none
                    let v = nextValue(it, args[0])
                    if it.signal != .none {
                        return Value.none
                    }
                    if !isAbsent(v) {
                        return v
                    }
                    if args.count > 1 {
                        return args[1]
                    }
                    raiseStop(it, it.stopValue)
                }
            }
        }
        "open" -> {
            if !arity(it, name, args, 1, 3) {
                return Value.none
            }
            openPath(it, args, kwNames, kwValues)
        }
        "super" -> {
            if args.count == 2 {
                match args[0] {
                    .klass(cls) -> { return .superRef(cell: it.newCell(args[1]), cls: cls) }
                    _ -> {}
                }
                return it.throw("TypeError", "super() argument 1 must be a type")
            }
            if it.curClass < 0 {
                return it.throw("RuntimeError", "super(): no arguments")
            }
            Value.superRef(cell: it.newCell(it.curSelf), cls: it.curClass)
        }
        "staticmethod" -> {
            if !arity(it, name, args, 1, 1) {
                return Value.none
            }
            Value.wrapper(kind: 0, id: it.newCell(args[0]))
        }
        "classmethod" -> {
            if !arity(it, name, args, 1, 1) {
                return Value.none
            }
            Value.wrapper(kind: 1, id: it.newCell(args[0]))
        }
        "property" -> {
            if !arity(it, name, args, 1, 4) {
                return Value.none
            }
            let cell = it.newCell(args[0])
            if args.count > 1 && args[1] != Value.none {
                it.setters[cell] = args[1]
            }
            if args.count > 2 && args[2] != Value.none {
                it.deleters[cell] = args[2]
            }
            Value.wrapper(kind: 2, id: cell)
        }
        "exit", "quit", "sys.exit" -> {
            var code = 0
            if !args.isEmpty {
                match args[0] {
                    .none -> {}
                    .str(s) -> {
                        emit(it, s + "\n", toError: true)
                        code = 1
                    }
                    _ -> { code = intOf(args[0]) ?? 1 }
                }
            }
            it.exiting = true
            it.exitCode = code
            // (Nothing catches it: `SystemExit` isn't an `Exception`.)
            it.throw("SystemExit", "{code}")
        }
        "id" -> {
            if !arity(it, name, args, 1, 1) {
                return Value.none
            }
            match args[0] {
                .list(id) -> .int(i: 0x10000000 + id * 8)
                .tuple(id) -> .int(i: 0x10000000 + id * 8)
                .dict(id) -> .int(i: 0x20000000 + id * 8)
                .set(id) -> .int(i: 0x20000000 + id * 8)
                .instance(id) -> .int(i: 0x30000000 + id * 8)
                .function(id) -> .int(i: 0x40000000 + id * 8)
                .klass(id) -> .int(i: 0x50000000 + id * 8)
                _ -> .int(i: textHash(hashKey(it, args[0])))
            }
        }
        "hash" -> {
            if !arity(it, name, args, 1, 1) {
                return Value.none
            }
            match args[0] {
                .int(_) -> { return args[0] }
                .bool(b) -> { return .int(i: if b { 1 } else { 0 }) }
                _ -> {}
            }
            let h = hashKey(it, args[0])
            if it.signal != .none {
                return Value.none
            }
            // (A float that's a whole number hashes as that number.)
            if h.hasPrefix("i") {
                if let n = Int(h.substring(from: 1, to: h.count)) {
                    return .int(i: n)
                }
            }
            let number = textHash(h)
            match args[0] {
                .instance(_) -> {}
                _ -> { it.hashTexts[number] = h }
            }
            Value.int(i: number)
        }
        "format" -> {
            if !arity(it, name, args, 1, 2) {
                return Value.none
            }
            var spec = ""
            if args.count > 1 {
                spec = toStr(it, args[1])
            }
            Value.str(s: formatValue(it, args[0], spec))
        }
        "vars" -> {
            if args.isEmpty {
                return snapshot(it, it.env)
            }
            getAttr(it, args[0], "__dict__")
        }
        "globals" -> snapshot(it, it.globalEnv())
        "locals" -> snapshot(it, it.env)
        "dir" -> {
            var names: [String] = []
            if args.isEmpty {
                names = it.envs[it.env].vars.keys
            } else {
                match args[0] {
                    .instance(id) -> {
                        let own = classAttr(it, it.instances[id].cls, "__dir__")
                        if own != Value.absent {
                            let listed = it.callValue(own, [args[0]], [], [])
                            if it.signal != .none {
                                return Value.none
                            }
                            let items = iterate(it, listed)
                            if it.signal != .none {
                                return Value.none
                            }
                            return it.newList(sortValues(it, items, Value.absent, false))
                        }
                        names = it.instances[id].fields.keys
                        for c in it.classes[it.instances[id].cls].mro {
                            names.appendAll(it.classes[c].attrs.keys)
                        }
                    }
                    .klass(id) -> {
                        for c in it.classes[id].mro {
                            names.appendAll(it.classes[c].attrs.keys)
                        }
                    }
                    .module(m) -> {
                        if let e = it.modules[m] {
                            names = it.envs[e].vars.keys
                        }
                    }
                    _ -> {}
                }
            }
            var out: [Value] = []
            for n in names.unique().sorted() {
                out.append(.str(s: n))
            }
            it.newList(out)
        }
        "eval" -> {
            if !arity(it, name, args, 1, 3) {
                return Value.none
            }
            match args[0] {
                .str(source) -> runSource(it, source, true)
                _ -> it.throw("TypeError", "eval() arg 1 must be a string")
            }
        }
        "exec" -> {
            if !arity(it, name, args, 1, 3) {
                return Value.none
            }
            match args[0] {
                .str(source) -> runSource(it, source, false)
                _ -> it.throw("TypeError", "exec() arg 1 must be a string")
            }
        }
        "object" -> instantiate(it, it.classIds["object"] ?? 0, [], [], [])
        "@noop" -> .none
        _ -> {
            if name.contains(".") {
                let parts = name.split(".")
                let owner = parts[0]
                let member = parts.dropFirst().joined(separator: ".")
                if isTypeName(owner) {
                    // str.upper(s), dict.fromkeys(keys): a type's method.
                    return typeMethod(it, owner, member, args, kwNames, kwValues)
                }
                return moduleCall(it, owner, member, args, kwNames, kwValues)
            }
            it.throw("TypeError", "'{name}' isn't something PyTessel can call")
        }
    }
}

// A number for a text, for hash() and id().
fn textHash(_ text: String) -> Int {
    var h = 1469598103934665603
    for b in Data(text: text).bytes {
        h = (h ^ b).wrappingMultiply(1099511628211)
    }
    if h < 0 { (0).wrappingSubtract(h) & 0x3fffffffffffffff } else { h & 0x3fffffffffffffff }
}

// A dictionary of an environment's variables, for globals() and locals().
fn snapshot(_ it: bind Interp, _ e: Int) -> Value {
    let id = it.newDict()
    for (k, v) in it.envs[e].vars {
        dictSet(it.dicts[id], .str(s: k), "s" + k, v)
    }
    Value.dict(id: id)
}

// The names every program starts with.
fn builtinNames() -> [String] {
    ["len", "range", "print", "str", "int", "float", "isinstance", "bool", "list", "tuple", "dict", "set", "frozenset",
     "bytes", "bytearray", "slice", "__abstractmethod__",
     "abs", "min", "max", "sum", "sorted", "enumerate", "zip", "map", "filter", "reversed", "any", "all", "repr",
     "ascii", "type", "issubclass", "input", "ord", "chr", "round", "divmod", "pow", "hex", "bin", "oct", "callable",
     "getattr", "hasattr", "setattr", "delattr", "iter", "next", "open", "super", "staticmethod", "classmethod",
     "property", "exit", "quit", "id", "hash", "format", "vars", "globals", "locals", "dir", "eval", "exec", "__host__"]
}

// The built-in exceptions, each with the one it's a kind of.
fn exceptionClasses() -> [(String, String)] {
    [("BaseException", "object"), ("Exception", "BaseException"), ("SystemExit", "BaseException"),
     ("GeneratorExit", "BaseException"),
     ("KeyboardInterrupt", "BaseException"), ("ArithmeticError", "Exception"), ("ZeroDivisionError", "ArithmeticError"),
     ("OverflowError", "ArithmeticError"), ("AssertionError", "Exception"), ("AttributeError", "Exception"),
     ("EOFError", "Exception"), ("ImportError", "Exception"), ("ModuleNotFoundError", "ImportError"),
     ("LookupError", "Exception"), ("IndexError", "LookupError"), ("KeyError", "LookupError"),
     ("NameError", "Exception"), ("UnboundLocalError", "NameError"), ("OSError", "Exception"),
     ("FileNotFoundError", "OSError"), ("FileExistsError", "OSError"), ("PermissionError", "OSError"),
     ("RuntimeError", "Exception"), ("NotImplementedError", "RuntimeError"), ("RecursionError", "RuntimeError"),
     ("TimeoutError", "OSError"),
     ("StopIteration", "Exception"), ("SyntaxError", "Exception"), ("TypeError", "Exception"),
     ("ValueError", "Exception"), ("UnicodeError", "ValueError"), ("UnicodeDecodeError", "UnicodeError"),
     ("UnicodeEncodeError", "UnicodeError"), ("MemoryError", "Exception"), ("UnsupportedOperation", "OSError")]
}
